import random
import math
import time
import pandas as pd
import numpy as np
from Functions.functions import *

def CVRP_setup(n, seed):

    random.seed(seed)

    coordinates = {
        0: (50,50)
    }

    for i in range(1,n+1):
        coordinates[i] = (
            random.randint(0,100),
            random.randint(0,100)
        )


    demands = {0:0}

    for i in range(1,n+1):
        demands[i] = random.randint(5,15)


    return coordinates, demands

def create_distance_matrix(coordinates):

    n = len(coordinates)

    distance_matrix = np.zeros((n,n))

    for i in range(n):
        for j in range(n):

            x1,y1 = coordinates[i]
            x2,y2 = coordinates[j]

            distance_matrix[i,j] = math.hypot(
                x2-x1,
                y2-y1
            )

    return distance_matrix


