import math
import random
import time
import numpy as np
import vrplib
import matplotlib.pyplot as plt
from Functions.functions import *

random.seed(10)

OPTIMAL_COST = 735

# -------------------------------
# Load CVRPLIB instance
# -------------------------------

instance = vrplib.read_instance("Instances/E-n76-k8.vrp")


coordinates = {
    i: tuple(instance["node_coord"][i])
    for i in range(len(instance["node_coord"]))
}

demands = {
    i: int(instance["demand"][i])
    for i in range(len(instance["demand"]))
}

vehicle_capacity = instance["capacity"]

# -------------------------------
# Distance matrix
# -------------------------------

def distance(i, j):
    x1, y1 = coordinates[i]
    x2, y2 = coordinates[j]
    return math.hypot(x2 - x1, y2 - y1)

n = len(coordinates)

distance_matrix = np.zeros((n, n))

for i in range(n):
    for j in range(n):
        distance_matrix[i, j] = distance(i, j)

# -------------------------------
# Run algorithms
# -------------------------------

start = time.perf_counter()
routes_nn_sa = nn_sa_CVRP(
    coordinates,
    demands,
    distance_matrix,
    vehicle_capacity,
)
time_nn_sa = time.perf_counter() - start

start = time.perf_counter()
routes_sweep_sa = sweep_sa_CVRP(
    coordinates,
    demands,
    distance_matrix,
    vehicle_capacity,
)
time_sweep_sa = time.perf_counter() - start

start = time.perf_counter()
routes_sa_split = sa_split_CVRP(
    coordinates,
    demands,
    distance_matrix,
    vehicle_capacity,
)
time_sa_split = time.perf_counter() - start

start = time.perf_counter()
routes_nn = nearest_neighbour_cvrp(
    coordinates,
    demands,
    distance_matrix,
    vehicle_capacity,
)
time_nn = time.perf_counter() - start

# -------------------------------
# Cost function
# -------------------------------

def cvrp_route_cost(route):
    cost = 0
    for i in range(len(route) - 1):
        cost += distance_matrix[route[i], route[i + 1]]
    return cost


# -------------------------------
# Print routes and compute totals
# -------------------------------

def print_solution(name, routes):
    total = 0

    print(f"\n{name}\n")

    for i, (route, load) in enumerate(routes, start=1):
        cost = cvrp_route_cost(route)
        total += cost

        print(f"Vehicle {i}")
        print(" Route:", route)
        print(" Load :", load)
        print(f" Cost : {cost:.2f}\n")

    print(f"Total distance = {total:.2f}")

    return total


total_cost_nn_sa = print_solution("NN-SA", routes_nn_sa)
total_cost_sweep_sa = print_solution("Sweep-SA", routes_sweep_sa)
total_cost_sa_split = print_solution("SA-Split", routes_sa_split)
total_cost_nn = print_solution("Nearest Neighbour", routes_nn)

# -------------------------------
# Compute gaps
# -------------------------------

def gap(cost):
    return 100 * (cost - OPTIMAL_COST) / OPTIMAL_COST

# -------------------------------
# Summary
# -------------------------------

print("\n")
print("=" * 70)
print("SUMMARY")
print("=" * 70)
print(f"{'Method':<20}{'Cost':>12}{'Runtime(s)':>15}{'Gap (%)':>15}")
print("-" * 70)

print(f"{'Nearest Neighbour':<20}{total_cost_nn:>12.2f}{time_nn:>15.3f}{gap(total_cost_nn):>15.2f}")

print(f"{'NN-SA':<20}{total_cost_nn_sa:>12.2f}{time_nn_sa:>15.3f}{gap(total_cost_nn_sa):>15.2f}")

print(f"{'Sweep-SA':<20}{total_cost_sweep_sa:>12.2f}{time_sweep_sa:>15.3f}{gap(total_cost_sweep_sa):>15.2f}")

print(f"{'SA-Split':<20}{total_cost_sa_split:>12.2f}{time_sa_split:>15.3f}{gap(total_cost_sa_split):>15.2f}")

print("=" * 70)