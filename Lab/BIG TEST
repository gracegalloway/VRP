# OPERATOR LISTS
# ============================================================

destroy_ops = [
    random_removal,
    worst_removal,
    string_removal
]

repair_ops = [
    random_insert,
    greedy_insert,
    regret_2_insert
]


# ============================================================
# ROULETTE-WHEEL SELECTION
# ============================================================

def choose(weights):

    total = sum(weights)

    r = random.random() * total

    cumulative = 0

    for i, weight in enumerate(weights):

        cumulative += weight

        if cumulative >= r:
            return i

    return len(weights) - 1


# ============================================================
# ALNS
# ============================================================

def alns(
    remove_fraction=0.30,
    iterations=3000,
    temperature=1000,
    cooling=0.995
):

    # --------------------------------------------------------
    # Initial solution
    # --------------------------------------------------------

    current = CW_initial_solution()

    current_cost = objective(
        current
    )

    best = copy_solution(
        current
    )

    best_cost = current_cost

    # --------------------------------------------------------
    # Adaptive weights
    # --------------------------------------------------------

    destroy_weights = [
        1.0,
        1.0,
        1.0
    ]

    repair_weights = [
        1.0,
        1.0,
        1.0
    ]

    # --------------------------------------------------------
    # Main ALNS loop
    # --------------------------------------------------------

    for iteration in range(
        iterations
    ):

        remove_count = max(
            1,
            int(
                remove_fraction
                * (n - 1)
            )
        )

        # Don't remove every customer
        remove_count = min(
            remove_count,
            n - 2
        )

        # Select destroy and repair operators
        d = choose(
            destroy_weights
        )

        r = choose(
            repair_weights
        )

        # ----------------------------------------------------
        # Destroy
        # ----------------------------------------------------

        partial, removed = (
            destroy_ops[d](
                current,
                remove_count
            )
        )

        # ----------------------------------------------------
        # Repair
        # ----------------------------------------------------

        candidate = repair_ops[r](
            partial,
            removed
        )

        # Safety check
        if not feasible(candidate):
            continue

        candidate_cost = objective(
            candidate
        )

        delta = (
            candidate_cost
            - current_cost
        )

        # ----------------------------------------------------
        # Simulated annealing acceptance
        # ----------------------------------------------------

        if delta < 0:

            accept = True

        else:

            exponent = (
                -delta / temperature
            )

            if exponent > -700:

                probability = math.exp(
                    exponent
                )

                accept = (
                    random.random()
                    < probability
                )

            else:

                accept = False

        # ----------------------------------------------------
        # Adaptive weight update
        # ----------------------------------------------------

        if accept:

            current = candidate
            current_cost = candidate_cost

            if current_cost < best_cost:

                # New global best
                best = copy_solution(
                    current
                )

                best_cost = current_cost

                destroy_weights[d] += 20
                repair_weights[r] += 20

            elif delta < 0:

                # Improved current solution
                destroy_weights[d] += 7
                repair_weights[r] += 7

            else:

                # Accepted worse solution
                destroy_weights[d] += 1
                repair_weights[r] += 1

        # ----------------------------------------------------
        # Temperature cooling
        # ----------------------------------------------------

        temperature *= cooling

        # ----------------------------------------------------
        # Weight decay
        # ----------------------------------------------------

        destroy_weights[d] *= 0.995
        repair_weights[r] *= 0.995

    return (
        best,
        total_cost(best)
    )


# ============================================================
# 3. GENETIC ALGORITHM
# ============================================================

def crossover(
    parent1,
    parent2
):

    p1 = copy_solution(
        parent1
    )

    p2 = copy_solution(
        parent2
    )

    random.shuffle(
        p1
    )

    number_routes = random.randint(
        1,
        max(
            1,
            len(p1) - 1
        )
    )

    selected_routes = p1[
        :number_routes
    ]

    child = copy_solution(
        selected_routes
    )

    inherited = set()

    for route in selected_routes:

        inherited.update(
            route
        )

    remaining = []

    for route in p2:

        for customer in route:

            if customer not in inherited:

                remaining.append(
                    customer
                )

    for customer in remaining:

        best_route = None
        best_position = None
        best_delta = float(
            "inf"
        )

        for r, route in enumerate(child):

            if (
                route_load(route)
                + demands[customer]
                > vehicle_capacity
            ):
                continue

            for pos in range(
                len(route) + 1
            ):

                # O(1) instead of rebuilding + route_cost(new_route)
                delta = insertion_cost(
                    route,
                    pos,
                    customer
                )

                if delta < best_delta:

                    best_delta = delta
                    best_route = r
                    best_position = pos

        if best_route is not None:

            child[
                best_route
            ].insert(
                best_position,
                customer
            )

        else:

            child.append(
                [customer]
            )

    return child


def mutate(solution):

    sol = copy_solution(
        solution
    )

    operator = random.choice(
        NEIGHBOURS
    )

    candidate = operator(
        sol
    )

    if (
        candidate is not None
        and feasible(candidate)
    ):

        return candidate

    return sol


def tournament(
    population,
    k=3
):

    competitors = random.sample(
        population,
        k
    )

    competitors.sort(
        key=lambda x: x[1]
    )

    return competitors[0][0]


def genetic_algorithm(
    pop_size=50,
    generations=300,
    elite_size=5,
    mutation_rate=0.9,
    crossover_rate=0.9
):

    population = []

    num_cw = int(
        0.2 * pop_size
    )

    for i in range(
        pop_size
    ):

        if i < num_cw:

            solution = (
                CW_initial_solution()
            )

            for _ in range(
                random.randint(1, 3)
            ):

                solution = mutate(
                    solution
                )

        else:

            solution = (
                random_initial_solution()
            )

        population.append(
            (
                solution,
                objective(solution)
            )
        )

    best_solution = None

    best_objective = float(
        "inf"
    )

    for generation in range(
        generations
    ):

        population.sort(
            key=lambda x: x[1]
        )

        if (
            population[0][1]
            < best_objective
        ):

            best_solution = copy_solution(
                population[0][0]
            )

            best_objective = (
                population[0][1]
            )

        new_population = []

        # Elitism

        for i in range(
            elite_size
        ):

            solution_copy, obj_copy = population[i]

            new_population.append(
                (
                    copy_solution(solution_copy),
                    obj_copy
                )
            )

        # New population

        while len(new_population) < pop_size:

            parent1 = tournament(
                population
            )

            parent2 = tournament(
                population
            )

            if (
                random.random()
                < crossover_rate
            ):

                child = crossover(
                    parent1,
                    parent2
                )

            else:

                child = copy_solution(
                    parent1
                )

            if (
                random.random()
                < mutation_rate
            ):

                child = mutate(
                    child
                )

            new_population.append(
                (
                    child,
                    objective(child)
                )
            )

        population = new_population

    return (
        best_solution,
        total_cost(best_solution)
    )


# ============================================================
# 4. QACVRP
# ============================================================

def solution_to_edges(solution):

    edges = set()

    for route in solution:

        if not route:
            continue

        previous = DEPOT

        for customer in route:

            edge = tuple(
                sorted(
                    (
                        previous,
                        customer
                    )
                )
            )

            edges.add(
                edge
            )

            previous = customer

        edge = tuple(
            sorted(
                (
                    previous,
                    DEPOT
                )
            )
        )

        edges.add(
            edge
        )

    return edges


def spin_products(
    edges_previous,
    edges_current,
    edges_next
):

    return (
        len(
            edges_previous
            & edges_current
        )
        +
        len(
            edges_current
            & edges_next
        )
    )


def qacvrp(
    P=40,
    T=0.0225,
    gamma=3.0,
    gamma_decrement=0.0,
    Mc=20_000
):

    replicas = []

    for _ in range(P):

        solution = (
            random_initial_solution()
        )

        replicas.append(
            {
                "solution": solution,
                "edges": solution_to_edges(
                    solution
                ),
                "objective": objective(
                    solution
                )
            }
        )

    best_replica = min(
        replicas,
        key=lambda x: x["objective"]
    )

    best_solution = copy_solution(
        best_replica["solution"]
    )

    best_objective = (
        best_replica["objective"]
    )

    for mc in range(Mc):

        x = (
            gamma
            / (P * T)
        )

        J = -(
            T / 2.0
        ) * math.log(
            math.tanh(x)
        )

        for z in range(P):

            current = replicas[z]

            previous = replicas[
                (z - 1) % P
            ]

            next_replica = replicas[
                (z + 1) % P
            ]

            candidate_solution = (
                make_neighbour(
                    current["solution"]
                )
            )

            if candidate_solution is None:
                continue

            candidate_edges = (
                solution_to_edges(
                    candidate_solution
                )
            )

            candidate_objective = (
                objective(
                    candidate_solution
                )
            )

            delta_H_pot = (
                candidate_objective
                - current["objective"]
            )

            old_spin_product = (
                spin_products(
                    previous["edges"],
                    current["edges"],
                    next_replica["edges"]
                )
            )

            new_spin_product = (
                spin_products(
                    previous["edges"],
                    candidate_edges,
                    next_replica["edges"]
                )
            )

            delta_H_kin = (
                new_spin_product
                - old_spin_product
            )

            delta_H = (
                delta_H_pot / P
                -
                J * delta_H_kin
            )

            if (
                delta_H_pot <= 0
                or delta_H <= 0
            ):

                accept = True

            else:

                exponent = (
                    -delta_H / T
                )

                if exponent > -700:

                    probability = math.exp(
                        exponent
                    )

                    accept = (
                        random.random()
                        < probability
                    )

                else:

                    accept = False

            if accept:

                replicas[z][
                    "solution"
                ] = candidate_solution

                replicas[z][
                    "edges"
                ] = candidate_edges

                replicas[z][
                    "objective"
                ] = candidate_objective

                if (
                    candidate_objective
                    < best_objective
                ):

                    best_objective = (
                        candidate_objective
                    )

                    best_solution = (
                        copy_solution(
                            candidate_solution
                        )
                    )

        gamma = max(
            0.0,
            gamma - gamma_decrement
        )

    return (
        best_solution,
        total_cost(best_solution)
    )


# ============================================================
# RUN ONE ALGORITHM
# ============================================================

def run_algorithm(name):

    costs = []
    runtimes = []

    for run in range(
        NUM_RUNS
    ):

        # Same seed for each algorithm
        # on the corresponding run.

        random.seed(
            20 + run
        )

        np.random.seed(
            20 + run
        )

        start = time.time()

        if name == "SA":

            best, cost = (
                simulated_annealing()
            )

        elif name == "ALNS":

            best, cost = alns(
                remove_fraction=0.30,
                iterations=3000,
                temperature=1000,
                cooling=0.995
            )

        elif name == "GA":

            best, cost = genetic_algorithm(
                pop_size=50,
                generations=300,
                elite_size=5,
                mutation_rate=0.9,
                crossover_rate=0.9
            )

        elif name == "QA":

            best, cost = qacvrp(
                P=P,
                T=T,
                gamma=GAMMA,
                gamma_decrement=GAMMA_DECREMENT,
                Mc=MC_STEPS
            )

        else:

            raise ValueError(
                "Unknown algorithm"
            )

        elapsed = (
            time.time()
            - start
        )

        costs.append(
            cost
        )

        runtimes.append(
            elapsed
        )

        print(
            f"{name} | "
            f"Run {run + 1}/{NUM_RUNS} | "
            f"Cost = {cost:.2f} | "
            f"Time = {elapsed:.3f}s"
        )

    mean_cost = np.mean(
        costs
    )

    best_cost = min(
        costs
    )

    std_cost = np.std(
        costs
    )

    mean_runtime = np.mean(
        runtimes
    )

    gap = (
        (
            mean_cost
            - OPTIMAL_DISTANCE
        )
        / OPTIMAL_DISTANCE
        * 100
    )

    return {
        "mean_cost": mean_cost,
        "best_cost": best_cost,
        "std_cost": std_cost,
        "mean_runtime": mean_runtime,
        "gap": gap
    }


