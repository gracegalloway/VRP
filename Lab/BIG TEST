import math
import time
import copy
import vrplib


# ============================================================
# SETTINGS
# ============================================================
SEED = 20
INSTANCE = "Instances/E-n30-k3.vrp"

# Known optimal distance
OPTIMAL_DISTANCE =534


# Number of runs per algorithm
NUM_RUNS = 5


# ============================================================
# QACVRP PARAMETERS
# ============================================================

P = 40
T = 0.0225
GAMMA = 3.0
GAMMA_DECREMENT = 0.0

MC_STEPS = 20_000


# ============================================================
# INSTANCE
# ============================================================

instance = vrplib.read_instance(INSTANCE)

coordinates = {
    i: tuple(instance["node_coord"][i])
    for i in range(len(instance["node_coord"]))
}

demands = {
    i: int(instance["demand"][i])
    for i in range(len(instance["demand"]))
}

vehicle_capacity = int(instance["capacity"])

DEPOT = 0

customers = [
    i for i in coordinates
    if i != DEPOT
]

n = len(coordinates)


# ============================================================
# DISTANCE MATRIX
# ============================================================
#
# Match the second file:
# Euclidean distance rounded to nearest integer.
#
# ============================================================

def euclidean(a, b):

    return round(
        math.hypot(
            a[0] - b[0],
            a[1] - b[1]
        )
    )


distance = [
    [
        euclidean(
            coordinates[i],
            coordinates[j]
        )
        for j in range(n)
    ]
    for i in range(n)
]


# ============================================================
# MINIMUM NUMBER OF FEASIBLE VEHICLES
# ============================================================

min_K = math.ceil(
    sum(demands.values())
    / vehicle_capacity
)


# ============================================================
# BASIC CVRP FUNCTIONS
# ============================================================

def route_load(route):

    return sum(
        demands[i]
        for i in route
    )


def route_cost(route):

    if len(route) == 0:
        return 0

    cost = distance[
        DEPOT
    ][
        route[0]
    ]

    for i in range(
        len(route) - 1
    ):

        cost += distance[
            route[i]
        ][
            route[i + 1]
        ]

    cost += distance[
        route[-1]
    ][
        DEPOT
    ]

    return cost


def insertion_cost(route, pos, customer):
    """O(1) cost of inserting `customer` at position `pos` in `route`.
    Equivalent to route_cost(route[:pos] + [customer] + route[pos:]) -
    route_cost(route), but without rebuilding or re-summing the route."""

    prev = DEPOT if pos == 0 else route[pos - 1]
    nxt = DEPOT if pos == len(route) else route[pos]

    return (
        distance[prev][customer]
        + distance[customer][nxt]
        - distance[prev][nxt]
    )


# ============================================================
# ACTUAL CVRP COST
# ============================================================

def total_cost(solution):

    return sum(
        route_cost(route)
        for route in solution
    )


# ============================================================
# OBJECTIVE
# ============================================================
#
# Same formulation as second file:
#
# distance + penalty for vehicles above minimum feasible K.
#
# ============================================================

vehicle_penalty = 1000


def objective(solution):

    extra = max(
        0,
        len(solution) - min_K
    )

    return (
        total_cost(solution)
        + vehicle_penalty * extra
    )


# ============================================================
# FEASIBILITY
# ============================================================

def feasible(solution):

    seen = []

    for route in solution:

        if not route:
            return False

        if (
            route_load(route)
            > vehicle_capacity
        ):
            return False

        seen.extend(route)

    return (
        sorted(seen)
        == sorted(customers)
    )


# ============================================================
# COPY SOLUTION
# ============================================================

def copy_solution(solution):

    return [
        route.copy()
        for route in solution
    ]


# ============================================================
# INITIAL SOLUTIONS
# ============================================================

def CW_initial_solution():

    routes = {
        i: [i]
        for i in customers
    }

    loads = {
        i: demands[i]
        for i in customers
    }

    customer_route = {
        i: i
        for i in customers
    }

    savings = []

    for i in customers:

        for j in customers:

            if i < j:

                s = (
                    distance[DEPOT][i]
                    + distance[DEPOT][j]
                    - distance[i][j]
                )

                savings.append(
                    (s, i, j)
                )

    savings.sort(
        reverse=True
    )

    for saving, i, j in savings:

        if saving <= 0:
            break

        ri = customer_route[i]
        rj = customer_route[j]

        if ri == rj:
            continue

        route_i = routes[ri]
        route_j = routes[rj]

        if (
            loads[ri]
            + loads[rj]
            > vehicle_capacity
        ):
            continue

        merged = None

        if (
            route_i[-1] == i
            and route_j[0] == j
        ):

            merged = (
                route_i
                + route_j
            )

        elif (
            route_j[-1] == j
            and route_i[0] == i
        ):

            merged = (
                route_j
                + route_i
            )

        elif (
            route_i[0] == i
            and route_j[0] == j
        ):

            merged = (
                list(reversed(route_i))
                + route_j
            )

        elif (
            route_i[-1] == i
            and route_j[-1] == j
        ):

            merged = (
                route_i
                + list(reversed(route_j))
            )

        if merged is None:
            continue

        routes[ri] = merged
        loads[ri] += loads[rj]

        for customer in merged:

            customer_route[
                customer
            ] = ri

        del routes[rj]
        del loads[rj]

    return list(
        routes.values()
    )


def random_initial_solution():

    shuffled = customers.copy()

    random.shuffle(
        shuffled
    )

    solution = []

    for customer in shuffled:

        feasible_routes = [
            r
            for r, route in enumerate(solution)
            if (
                route_load(route)
                + demands[customer]
                <= vehicle_capacity
            )
        ]

        if feasible_routes:

            r = random.choice(
                feasible_routes
            )

            position = random.randint(
                0,
                len(solution[r])
            )

            solution[r].insert(
                position,
                customer
            )

        else:

            solution.append(
                [customer]
            )

    return solution


# ============================================================
# COMMON NEIGHBOURHOODS
# ============================================================

def nonempty_routes(solution):

    return [
        r
        for r, route in enumerate(solution)
        if route
    ]


# ------------------------------------------------------------
# 1. INTER-ROUTE RELOCATE
# ------------------------------------------------------------

def insert_move(solution):

    new_solution = copy_solution(
        solution
    )

    sources = nonempty_routes(
        new_solution
    )

    if not sources:
        return None

    source = random.choice(
        sources
    )

    customer = random.choice(
        new_solution[source]
    )

    destinations = [
        r
        for r in range(
            len(new_solution)
        )
        if r != source
    ]

    random.shuffle(
        destinations
    )

    for destination in destinations:

        if (
            route_load(
                new_solution[destination]
            )
            + demands[customer]
            <= vehicle_capacity
        ):

            new_solution[source].remove(
                customer
            )

            position = random.randint(
                0,
                len(
                    new_solution[destination]
                )
            )

            new_solution[destination].insert(
                position,
                customer
            )

            if not new_solution[source]:

                del new_solution[source]

            return new_solution

    # Create a new route if necessary

    new_solution[source].remove(
        customer
    )

    new_solution.append(
        [customer]
    )

    if not new_solution[source]:

        del new_solution[source]

    return new_solution


# ------------------------------------------------------------
# 2. INTER-ROUTE SWAP
# ------------------------------------------------------------

def swap_move(solution):

    new_solution = copy_solution(
        solution
    )

    routes = nonempty_routes(
        new_solution
    )

    if len(routes) < 2:
        return None

    r1, r2 = random.sample(
        routes,
        2
    )

    i = random.randrange(
        len(new_solution[r1])
    )

    j = random.randrange(
        len(new_solution[r2])
    )

    c1 = new_solution[r1][i]
    c2 = new_solution[r2][j]

    load1 = (
        route_load(new_solution[r1])
        - demands[c1]
        + demands[c2]
    )

    load2 = (
        route_load(new_solution[r2])
        - demands[c2]
        + demands[c1]
    )

    if (
        load1 <= vehicle_capacity
        and
        load2 <= vehicle_capacity
    ):

        new_solution[r1][i] = c2
        new_solution[r2][j] = c1

        return new_solution

    return None


# ------------------------------------------------------------
# 3. INTRA-ROUTE 2-OPT
# ------------------------------------------------------------

def two_opt_move(solution):

    new_solution = copy_solution(
        solution
    )

    routes = [
        r
        for r in range(
            len(new_solution)
        )
        if len(new_solution[r]) >= 4
    ]

    if not routes:
        return None

    r = random.choice(
        routes
    )

    route = new_solution[r]

    i, j = sorted(
        random.sample(
            range(len(route)),
            2
        )
    )

    route[i:j + 1] = reversed(
        route[i:j + 1]
    )

    return new_solution


# ------------------------------------------------------------
# 4. CROSS
# ------------------------------------------------------------

def cross_move(solution):

    new_solution = copy_solution(
        solution
    )

    routes = [
        r
        for r in range(
            len(new_solution)
        )
        if len(new_solution[r]) >= 2
    ]

    if len(routes) < 2:
        return None

    r1, r2 = random.sample(
        routes,
        2
    )

    route1 = new_solution[r1]
    route2 = new_solution[r2]

    i1, j1 = sorted(
        random.sample(
            range(len(route1)),
            2
        )
    )

    i2, j2 = sorted(
        random.sample(
            range(len(route2)),
            2
        )
    )

    segment1 = route1[
        i1:j1 + 1
    ]

    segment2 = route2[
        i2:j2 + 1
    ]

    load1 = (
        route_load(route1)
        - sum(
            demands[x]
            for x in segment1
        )
        + sum(
            demands[x]
            for x in segment2
        )
    )

    load2 = (
        route_load(route2)
        - sum(
            demands[x]
            for x in segment2
        )
        + sum(
            demands[x]
            for x in segment1
        )
    )

    if (
        load1 <= vehicle_capacity
        and
        load2 <= vehicle_capacity
    ):

        new_solution[r1] = (
            route1[:i1]
            + segment2
            + route1[j1 + 1:]
        )

        new_solution[r2] = (
            route2[:i2]
            + segment1
            + route2[j2 + 1:]
        )

        return new_solution

    return None


# ------------------------------------------------------------
# 5. SCRAMBLE
# ------------------------------------------------------------

def scramble_move(solution):

    new_solution = copy_solution(
        solution
    )

    routes = [
        r
        for r in range(
            len(new_solution)
        )
        if len(new_solution[r]) >= 3
    ]

    if not routes:
        return None

    r = random.choice(
        routes
    )

    route = new_solution[r]

    i, j = sorted(
        random.sample(
            range(len(route)),
            2
        )
    )

    segment = route[
        i:j + 1
    ]

    random.shuffle(
        segment
    )

    route[
        i:j + 1
    ] = segment

    return new_solution


# ------------------------------------------------------------
# 6. STRING INSERT
# ------------------------------------------------------------

def string_insert_move(solution):

    new_solution = copy_solution(
        solution
    )

    sources = [
        r
        for r in range(
            len(new_solution)
        )
        if len(new_solution[r]) >= 2
    ]

    if not sources:
        return None

    source = random.choice(
        sources
    )

    destinations = [
        r
        for r in range(
            len(new_solution)
        )
        if r != source
    ]

    if not destinations:
        return None

    destination = random.choice(
        destinations
    )

    route = new_solution[source]

    i, j = sorted(
        random.sample(
            range(len(route)),
            2
        )
    )

    segment = route[
        i:j + 1
    ]

    segment_demand = sum(
        demands[x]
        for x in segment
    )

    if (
        route_load(
            new_solution[destination]
        )
        + segment_demand
        > vehicle_capacity
    ):
        return None

    del route[
        i:j + 1
    ]

    position = random.randint(
        0,
        len(
            new_solution[destination]
        )
    )

    new_solution[destination][
        position:position
    ] = segment

    if not new_solution[source]:

        del new_solution[source]

    return new_solution


# ------------------------------------------------------------
# 7. 2-OPT*
# ------------------------------------------------------------

def two_opt_star_move(solution):

    new_solution = copy_solution(
        solution
    )

    routes = [
        r
        for r in range(
            len(new_solution)
        )
        if len(new_solution[r]) >= 2
    ]

    if len(routes) < 2:
        return None

    r1, r2 = random.sample(
        routes,
        2
    )

    route1 = new_solution[r1]
    route2 = new_solution[r2]

    cut1 = random.randint(
        1,
        len(route1) - 1
    )

    cut2 = random.randint(
        1,
        len(route2) - 1
    )

    first1 = route1[:cut1]
    end1 = route1[cut1:]

    first2 = route2[:cut2]
    end2 = route2[cut2:]

    candidate1 = first1 + end2
    candidate2 = first2 + end1

    if (
        route_load(candidate1)
        <= vehicle_capacity
        and
        route_load(candidate2)
        <= vehicle_capacity
    ):

        new_solution[r1] = candidate1
        new_solution[r2] = candidate2

        new_solution = [
            route
            for route in new_solution
            if route
        ]

        return new_solution

    return None


# ============================================================
# COMMON OPERATOR LIST
# ============================================================

NEIGHBOURS = [
    insert_move,
    swap_move,
    two_opt_move,
    cross_move,
    scramble_move,
    string_insert_move,
    two_opt_star_move
]


# ============================================================
# MAKE NEIGHBOUR
# ============================================================

def make_neighbour(solution):

    for _ in range(10):

        operator = random.choice(
            NEIGHBOURS
        )

        candidate = operator(
            solution
        )

        if (
            candidate is not None
            and feasible(candidate)
        ):

            return candidate

    return None


# ============================================================
# 1. SIMULATED ANNEALING
# ============================================================

def simulated_annealing(
    initial_temp=700,
    cooling_rate=0.995,
    stopping_temp=1e-3,
    iterations_per_temp=100
):

    current = CW_initial_solution()

    current_cost = objective(
        current
    )

    best = copy_solution(
        current
    )

    best_objective = current_cost

    T_current = initial_temp

    while T_current > stopping_temp:

        for _ in range(
            iterations_per_temp
        ):

            candidate = make_neighbour(
                current
            )

            if candidate is None:
                continue

            candidate_cost = objective(
                candidate
            )

            delta = (
                candidate_cost
                - current_cost
            )

            if delta <= 0:

                accept = True

            else:

                probability = math.exp(
                    -delta / T_current
                )

                accept = (
                    random.random()
                    < probability
                )

            if accept:

                current = candidate
                current_cost = candidate_cost

                if (
                    current_cost
                    < best_objective
                ):

                    best = copy_solution(
                        current
                    )

                    best_objective = (
                        current_cost
                    )

        T_current *= cooling_rate

    return (
        best,
        total_cost(best)
    )


# ============================================================
# 2. ALNS
# ============================================================

#############################################################################
# ADAPTIVE LARGE NEIGHBOURHOOD SEARCH
#
# Fixes applied vs. earlier version:
#   - string_removal's max_string_size now correctly caps at
#     MAX_STRING_SIZE (was `max(...)`, which could exceed the cap on
#     instances with long average routes).
#   - regret_2_insert now gives customers with only one feasible slot
#     maximal regret (float("inf")) instead of zero, since they're the
#     most urgent to place, not the least.
#
# Performance changes vs. earlier version:
#   - greedy_insert / regret_2_insert use insertion_cost() for O(1)
#     per-candidate-position evaluation instead of rebuilding the route
#     and calling route_cost() on the whole thing each time.
#   - copy.deepcopy replaced with copy_solution() (shallow per-route
#     copy), since routes are flat lists of ints.
#############################################################################

# ============================================================
# PARAMETERS
# ============================================================

MAX_STRING_REMOVALS = 2
MAX_STRING_SIZE = 12


# ============================================================
# 1. RANDOM REMOVAL
# ============================================================

def random_removal(solution, remove_count):

    sol = copy_solution(solution)

    customers_in_solution = []

    for r, route in enumerate(sol):
        for i, customer in enumerate(route):
            customers_in_solution.append(
                (r, i, customer)
            )

    remove_count = min(
        remove_count,
        len(customers_in_solution)
    )

    removed = random.sample(
        customers_in_solution,
        remove_count
    )

    removed_customers = []

    # Remove backwards so indices remain valid
    for r, i, customer in sorted(
        removed,
        reverse=True
    ):

        sol[r].pop(i)
        removed_customers.append(customer)

    sol = [
        route
        for route in sol
        if route
    ]

    return sol, removed_customers


# ============================================================
# 2. WORST REMOVAL
# ============================================================

def worst_removal(solution, remove_count):

    sol = copy_solution(solution)

    scores = []

    for r, route in enumerate(sol):

        for i, customer in enumerate(route):

            prev = (
                DEPOT
                if i == 0
                else route[i - 1]
            )

            nxt = (
                DEPOT
                if i == len(route) - 1
                else route[i + 1]
            )

            saving = (
                distance[prev][customer]
                + distance[customer][nxt]
                - distance[prev][nxt]
            )

            scores.append(
                (
                    saving,
                    r,
                    i,
                    customer
                )
            )

    # Large saving = customer whose removal gives
    # a large reduction in route cost
    scores.sort(
        reverse=True
    )

    removed = []

    for _, r, _, customer in scores:

        if len(removed) >= remove_count:
            break

        if (
            r < len(sol)
            and customer in sol[r]
        ):

            sol[r].remove(customer)
            removed.append(customer)

    sol = [
        route
        for route in sol
        if route
    ]

    return sol, removed


# ============================================================
# 3. STRING REMOVAL
# ============================================================

def remove_string(
    route,
    customer,
    max_string_size
):

    if not route:
        return []

    size = random.randint(
        1,
        min(
            len(route),
            max_string_size
        )
    )

    customer_index = route.index(
        customer
    )

    # Choose a start such that the chosen
    # string is guaranteed to contain customer
    start_min = max(
        0,
        customer_index - size + 1
    )

    start_max = min(
        customer_index,
        len(route) - size
    )

    if start_min > start_max:
        start = max(
            0,
            min(
                customer_index,
                len(route) - size
            )
        )
    else:
        start = random.randint(
            start_min,
            start_max
        )

    removed_customers = route[
        start:start + size
    ]

    del route[
        start:start + size
    ]

    return removed_customers


def string_removal(
    solution,
    remove_count
):

    sol = copy_solution(solution)

    if not sol:
        return sol, []

    removed_customers = []

    # Number of routes that can be destroyed
    max_string_removals = min(
        len(sol),
        MAX_STRING_REMOVALS
    )

    # Average route size
    avg_route_size = int(
        np.mean(
            [
                len(route)
                for route in sol
                if route
            ]
        )
    )

    max_string_size = min(
        MAX_STRING_SIZE,
        avg_route_size
    )

    max_string_size = max(
        max_string_size,
        1
    )

    # Pick a random customer as the centre
    nonempty_routes_list = [
        r
        for r, route in enumerate(sol)
        if route
    ]

    if not nonempty_routes_list:
        return sol, []

    centre_route = random.choice(
        nonempty_routes_list
    )

    centre_customer = random.choice(
        sol[centre_route]
    )

    # Candidate routes ordered by their
    # proximity to the centre customer.
    #
    # We use route customers and the distance
    # matrix instead of a separate neighbours()
    # function.
    route_scores = []

    for r, route in enumerate(sol):

        if not route:
            continue

        min_distance = min(
            distance[centre_customer][customer]
            for customer in route
        )

        route_scores.append(
            (
                min_distance,
                r
            )
        )

    route_scores.sort()

    destroyed_routes = set()

    # First try the centre route, then nearby routes
    for _, r in route_scores:

        if len(destroyed_routes) >= max_string_removals:
            break

        if not sol[r]:
            continue

        # Pick a customer from this route.
        # For the first route use the centre customer.
        if (
            r == centre_route
            and centre_customer in sol[r]
        ):
            customer = centre_customer
        else:
            customer = random.choice(
                sol[r]
            )

        removed = remove_string(
            sol[r],
            customer,
            max_string_size
        )

        removed_customers.extend(
            removed
        )

        destroyed_routes.add(r)

    sol = [
        route
        for route in sol
        if route
    ]

    # Never remove more than requested
    if len(removed_customers) > remove_count:

        excess = (
            len(removed_customers)
            - remove_count
        )

        # Put excess customers back into the
        # solution temporarily, then remove them
        # from removed list.
        excess_customers = (
            removed_customers[-excess:]
        )

        removed_customers = (
            removed_customers[:-excess]
        )

        for customer in excess_customers:
            sol.append([customer])

    return sol, removed_customers


# ============================================================
# 4. RANDOM INSERT
# ============================================================

def random_insert(
    solution,
    removed
):

    sol = copy_solution(solution)

    removed = removed.copy()

    random.shuffle(
        removed
    )

    for customer in removed:

        feasible_routes = [
            r
            for r, route in enumerate(sol)
            if (
                route_load(route)
                + demands[customer]
                <= vehicle_capacity
            )
        ]

        if feasible_routes:

            r = random.choice(
                feasible_routes
            )

            position = random.randint(
                0,
                len(sol[r])
            )

            sol[r].insert(
                position,
                customer
            )

        else:

            sol.append(
                [customer]
            )

    return sol


# ============================================================
# 5. GREEDY INSERT
# ============================================================

def greedy_insert(
    solution,
    removed
):

    sol = copy_solution(solution)

    for customer in removed:

        best_route = None
        best_position = None
        best_increase = float("inf")

        for r, route in enumerate(sol):

            if (
                route_load(route)
                + demands[customer]
                > vehicle_capacity
            ):
                continue

            for pos in range(
                len(route) + 1
            ):

                # O(1) instead of rebuilding + route_cost(new_route)
                increase = insertion_cost(
                    route,
                    pos,
                    customer
                )

                if increase < best_increase:

                    best_increase = increase
                    best_route = r
                    best_position = pos

        if best_route is None:

            sol.append(
                [customer]
            )

        else:

            sol[
                best_route
            ].insert(
                best_position,
                customer
            )

    return sol


# ============================================================
# 6. REGRET-2 INSERTION
# ============================================================

def regret_2_insert(
    solution,
    removed
):

    sol = copy_solution(solution)

    removed = removed.copy()

    while removed:

        best_customer = None
        best_route = None
        best_position = None
        best_regret = -float("inf")

        for customer in removed:

            insertions = []

            for r, route in enumerate(sol):

                if (
                    route_load(route)
                    + demands[customer]
                    > vehicle_capacity
                ):
                    continue

                for pos in range(
                    len(route) + 1
                ):

                    # O(1) instead of rebuilding + route_cost(new_route)
                    increase = insertion_cost(
                        route,
                        pos,
                        customer
                    )

                    insertions.append(
                        (
                            increase,
                            r,
                            pos
                        )
                    )

            if not insertions:
                continue

            insertions.sort(
                key=lambda x: x[0]
            )

            best = insertions[0]

            if len(insertions) >= 2:

                second_best = insertions[1]

                regret = (
                    second_best[0]
                    - best[0]
                )

            else:

                # Only one feasible slot left for this
                # customer — this is the *most* urgent
                # customer to place, not the least, since
                # another repair choice could remove that
                # last remaining feasible slot entirely.
                regret = float("inf")

            if regret > best_regret:

                best_regret = regret

                best_customer = customer
                best_route = best[1]
                best_position = best[2]

        if best_customer is None:

            customer = removed.pop(0)

            sol.append(
                [customer]
            )

        else:

            sol[
                best_route
            ].insert(
                best_position,
                best_customer
            )

            removed.remove(
                best_customer
            )

    return sol


