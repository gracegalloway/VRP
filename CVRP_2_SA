# create customer distances
def distance(i, j):
    x1, y1 = coordinates[i]
    x2, y2 = coordinates[j]
    return math.hypot(x2 - x1, y2 - y1)

n = len(coordinates)

# Build distance matrix
distance_matrix = np.zeros((n,n))

for i in range(n):
    for j in range(n):
        distance_matrix[i,j] = distance(i,j)


def route_load(route):
    return sum(demands[i] for i in route)


def route_cost(route):
    if len(route) == 0:
        return 0

    cost = distance[0][route[0]]

    for i in range(len(route)-1):
        cost += distance[route[i]][route[i+1]]

    cost += distance[route[-1]][0]

    return cost

