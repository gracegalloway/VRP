num_replicas_values = [6, 8, 10]
iterations_values = [50, 60, 80, 100]

num_runs = 5

tuning_results = []


#############################################################################
# TEST ALL COMBINATIONS
#############################################################################

for num_replicas in num_replicas_values:

    for iterations_per_temperature in iterations_values:

        costs = []
        runtimes = []

        print("\n" + "=" * 80)
        print(
            f"Testing replicas={num_replicas}, "
            f"iterations={iterations_per_temperature}"
        )
        print("=" * 80)

        for run in range(num_runs):

            start = time.time()

            best_solution, best_obj = simulated_quantum_annealing(

                num_replicas=num_replicas,

                iterations_per_temperature=iterations_per_temperature,

            )
            best_cost = total_cost(best_solution)
            end = time.time()

            costs.append(best_cost)
            runtimes.append(end - start)

            print(
                f"  Run {run + 1}: "
                f"cost={best_cost:.2f}, "
                f"time={end - start:.2f}s"
            )

        # ---------------------------------------------------------
        # Statistics
        # ---------------------------------------------------------

        mean_cost = np.mean(costs)
        best_cost = min(costs)
        std_cost = np.std(costs)
        mean_runtime = np.mean(runtimes)

        gap = (
            (mean_cost - OPTIMAL_COST)
            / OPTIMAL_COST
        ) * 100

        tuning_results.append({

            "num_replicas": num_replicas,

            "iterations": iterations_per_temperature,

            "mean_cost": mean_cost,

            "best_cost": best_cost,

            "std_cost": std_cost,

            "mean_runtime": mean_runtime,

            "gap": gap
        })


