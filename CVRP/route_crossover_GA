import numpy as np
import random
import time
import matplotlib.pyplot as plt
import math
import copy
import vrplib

random.seed(20)

OPTIMAL_COST = 735

instance = vrplib.read_instance("Instances/"
"E-n76-k8.vrp")


coordinates = {
    i: tuple(instance["node_coord"][i])
    for i in range(len(instance["node_coord"]))
}

demands = {
    i: int(instance["demand"][i])
    for i in range(len(instance["demand"]))
}

vehicle_capacity = instance["capacity"]

# create customer distances
def euclidean(a, b):
    return round(math.hypot(a[0]-b[0], a[1]-b[1]),1)

n = len(coordinates)

distance = [
    [euclidean(coordinates[i], coordinates[j]) for j in range(n)]
    for i in range(n)
]

# minimumn number of feasible vechiles
min_K = math.ceil(sum(demands.values()) / vehicle_capacity)

def route_load(route):
    return sum(demands[i] for i in route)


def route_cost(route):
    if len(route) == 0:
        return 0

    cost = distance[0][route[0]]

    for i in range(len(route)-1):
        cost += distance[route[i]][route[i+1]]

    cost += distance[route[-1]][0]

    return cost

vehicle_penalty = 1000  # large enough to dominate distance

# Actual CVRP cost
def total_cost(solution):
    return sum(route_cost(r) for r in solution)

# Objective used by simulated annealing (cost with extra vechile penalty)
def objective(solution):
    extra = max(0, len(solution) - min_K)
    return total_cost(solution) + vehicle_penalty * extra

# generate initial sol via parallel clarke and wright savings method
def CW_initial_solution():

    # initial routes
    routes = {i: [i] for i in range(1, n)}
    loads = {i: demands[i] for i in range(1, n)}
    customer_route = {i: i for i in range(1, n)}

    # compute savings
    savings = []
    for i in range(1, n):
        for j in range(i + 1, n):
            s = (
                distance[0][i]
                + distance[0][j]
                - distance[i][j]
            )
            savings.append((s, i, j))
    savings.sort(reverse=True)

    # -----------------------------
    # Merge routes
    # -----------------------------
    for saving, i, j in savings:
        if saving <= 0:
            break  # no point merging routes that don't save distance

        ri = customer_route[i]
        rj = customer_route[j]
        if ri == rj:
            continue

        route_i = routes[ri]
        route_j = routes[rj]

        if loads[ri] + loads[rj] > vehicle_capacity:
            continue

        merged = None
        # i at end of route_i, j at start of route_j
        if route_i[-1] == i and route_j[0] == j:
            merged = route_i + route_j
        # j at end of route_j, i at start of route_i
        elif route_j[-1] == j and route_i[0] == i:
            merged = route_j + route_i
        # both start points
        elif route_i[0] == i and route_j[0] == j:
            merged = list(reversed(route_i)) + route_j
        # both end points
        elif route_i[-1] == i and route_j[-1] == j:
            merged = route_i + list(reversed(route_j))

        if merged is None:
            continue

        # -----------------------------
        # Perform merge
        # -----------------------------
        routes[ri] = merged
        loads[ri] += loads[rj]
        for customer in merged:
            customer_route[customer] = ri
        del routes[rj]
        del loads[rj]

    return list(routes.values())

# random initial solutions to introduce diversity to population
def random_initial_solution():

    customers = list(range(1, n))
    random.shuffle(customers)

    solution = []

    for customer in customers:

        feasible_routes = []

        for r in range(len(solution)):

            if (
                route_load(solution[r])
                + demands[customer]
                <= vehicle_capacity
            ):
                feasible_routes.append(r)

        # Sometimes create a new route
        if not feasible_routes or random.random() < 0.2:

            solution.append([customer])

        else:

            r = random.choice(feasible_routes)

            position = random.randint(
                0,
                len(solution[r])
            )

            solution[r].insert(
                position,
                customer
            )

    return solution

# ---------------------------------------------------------
# CROSSOVER
# ---------------------------------------------------------

def crossover(parent1, parent2):

    # Deep copies so parents aren't changed
    p1 = copy.deepcopy(parent1)
    p2 = copy.deepcopy(parent2)

    child = []

    # -----------------------------------------------------
    # 1. Randomly select routes from parent 1
    # -----------------------------------------------------

    random.shuffle(p1)

    # At least one route, but don't necessarily inherit all
    number_routes = random.randint(1, max(1, len(p1) - 1))

    selected_routes = p1[:number_routes]

    child.extend(copy.deepcopy(selected_routes))

    # Customers already inherited
    inherited_customers = set()

    for route in selected_routes:
        inherited_customers.update(route)

    # -----------------------------------------------------
    # 2. Flatten parent 2 and remove inherited customers
    # -----------------------------------------------------

    remaining_customers = []

    for route in p2:
        for customer in route:

            if customer not in inherited_customers:
                remaining_customers.append(customer)

    # -----------------------------------------------------
    # 3. Insert remaining customers
    # -----------------------------------------------------

    for customer in remaining_customers:

        best_route = None
        best_position = None
        best_delta = float("inf")

        # Try every existing route
        for r_idx, route in enumerate(child):

            if route_load(route) + demands[customer] > vehicle_capacity:
                continue

            # Try every insertion position
            for pos in range(len(route) + 1):

                # Cost before insertion
                old_cost = route_cost(route)

                # New route after insertion
                new_route = route[:pos] + [customer] + route[pos:]

                new_cost = route_cost(new_route)

                delta = new_cost - old_cost

                if delta < best_delta:

                    best_delta = delta
                    best_route = r_idx
                    best_position = pos

        # -------------------------------------------------
        # Insert into best existing route
        # -------------------------------------------------

        if best_route is not None:

            child[best_route].insert(
                best_position,
                customer
            )

        # -------------------------------------------------
        # Otherwise create new route
        # -------------------------------------------------

        else:

            child.append([customer])

    return child


# -----------------------------
# Mutation Operators
# -----------------------------

def mutate(solution):

    sol = copy.deepcopy(solution)

    move = random.choice(["swap", "relocate", "reverse"])

    # ---------------- swap ----------------
    if move == "swap":

        if len(sol) < 2:
            return sol

        r1, r2 = random.sample(range(len(sol)), 2)

        if not sol[r1] or not sol[r2]:
            return sol

        i = random.randrange(len(sol[r1]))
        j = random.randrange(len(sol[r2]))

        a = sol[r1][i]
        b = sol[r2][j]

        load1 = route_load(sol[r1]) - demands[a] + demands[b]
        load2 = route_load(sol[r2]) - demands[b] + demands[a]

        if load1 <= vehicle_capacity and load2 <= vehicle_capacity:
            sol[r1][i], sol[r2][j] = b, a

    # ---------------- relocate ----------------
    elif move == "relocate":

        r1 = random.randrange(len(sol))

        if not sol[r1]:
            return sol

        idx = random.randrange(len(sol[r1]))
        customer = sol[r1].pop(idx)

        if len(sol[r1]) == 0:
            sol.pop(r1)

        r2 = random.randrange(len(sol))

        if route_load(sol[r2]) + demands[customer] <= vehicle_capacity:

            pos = random.randrange(len(sol[r2])+1)
            sol[r2].insert(pos, customer)

        else:
            sol.append([customer])

    # ---------------- reverse ----------------
    else:

        routes = [r for r in sol if len(r) >= 4]

        if routes:

            route = random.choice(routes)
            idx = sol.index(route)

            i, j = sorted(random.sample(range(len(route)), 2))

            if j-i > 1:
                route[i:j] = reversed(route[i:j])

            sol[idx] = route

    return sol

# -----------------------------
# Tournament Selection
# -----------------------------

def tournament(population, k=3):

    competitors = random.sample(population, k)

    competitors.sort(key=lambda x: x[1])

    return competitors[0][0]

# GA with crossover operators and mutation
# route-based crossover

def RBC_genetic_algorithm(
        pop_size=50,
        generations=300,
        elite_size=5,
        mutation_rate=0.9,
        crossover_rate=0.9):

    population = []

    num_cw = int(0.2 * pop_size)

    for i in range(pop_size):

        if i < num_cw:

            # Good starting solutions
            s = CW_initial_solution()

            # Add diversity
            for _ in range(random.randint(1, 3)):
                s = mutate(s)

        else:

            # Diverse random solutions
            s = random_initial_solution()

        population.append(
        (
            s,
            total_cost(s)
        )
        )

    best_solution = None
    best_cost = float("inf")

    for generation in range(generations):

        population.sort(key=lambda x: x[1])

        if population[0][1] < best_cost:
            best_solution = copy.deepcopy(population[0][0])
            best_cost = population[0][1]

        new_population = []

        # Elitism
        for i in range(elite_size):
            new_population.append(copy.deepcopy(population[i]))

        # -------------------------------------------------
        # Crossover + Mutation
        # -------------------------------------------------

        while len(new_population) < pop_size:

            # Select two parents
            parent1 = tournament(population)
            parent2 = tournament(population)

            # Avoid identical parent references
            # when possible
            attempts = 0

            while (
                parent1 == parent2
                and attempts < 5
            ):

                parent2 = tournament(
                    population
                )

                attempts += 1

            # ---------------------------------------------
            # Crossover
            # ---------------------------------------------

            if random.random() < crossover_rate:

                child = crossover(
                    parent1,
                    parent2
                )

            else:

                child = copy.deepcopy(
                    parent1
                )

            # ---------------------------------------------
            # Mutation
            # ---------------------------------------------

            if random.random() < mutation_rate:

                child = mutate(child)

            # ---------------------------------------------
            # Add child
            # ---------------------------------------------

            new_population.append(
                (
                    child,
                    total_cost(child)
                )
            )

        population = new_population

        print(
            f"Generation {generation:3d} "
            f"Best = {best_cost:.2f}"
        )

    return best_solution, best_cost

# -----------------------------
# Run
# -----------------------------

best, cost = RBC_genetic_algorithm()

print("\nBest Cost GA:", cost)

for i, route in enumerate(best):
    print(f"Vehicle {i+1}: 0 -> {' -> '.join(map(str, route))} -> 0")


results = {}


costs = []
runtimes = []

for run in range(10):

    start = time.time()

    best_solution, best_cost = RBC_genetic_algorithm(
        )


    end = time.time()

    costs.append(best_cost)
    runtimes.append(end - start)

results[f"x"] = {
    "mean_cost": np.mean(costs),
    "best_cost": min(costs),
    "std_cost": np.std(costs),
    "mean_runtime": np.mean(runtimes),
    "gap": ((np.mean(costs) - OPTIMAL_COST) / OPTIMAL_COST) * 100
    }


for name, result in results.items():

    print("\nSwitch temperature:", name)
    print("Mean cost:", round(result["mean_cost"], 2))
    print("Best cost:", round(result["best_cost"], 2))
    print("Std deviation:", round(result["std_cost"], 2))
    print("Mean runtime:", round(result["mean_runtime"], 3), "seconds")
    print("Gap from optimum:", round(result["gap"], 2), "%")