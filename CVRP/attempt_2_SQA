import numpy as np
import random
import math
import time
import vrplib


random.seed(20)
np.random.seed(20)

INSTANCE = "Instances/B-n33-k5.vrp"

#parameters used in paper (want PT=0.9)
P = 40
T = 0.0225
GAMMA = 3.0
GAMMA_DECREMENT = 0.0

MC_STEPS = 20_000
NUM_RUNS = 5

# Known optimal distance
OPTIMAL_DISTANCE = 955


# ============================================================
# INSTANCE
# ============================================================

instance = vrplib.read_instance(INSTANCE)

coordinates = {
    i: tuple(instance["node_coord"][i])
    for i in range(len(instance["node_coord"]))
}

demands = {
    i: int(instance["demand"][i])
    for i in range(len(instance["demand"]))
}

vehicle_capacity = int(instance["capacity"])

DEPOT = 0

customers = [
    i for i in coordinates
    if i != DEPOT
]


# ============================================================
# DISTANCE MATRIX
# ============================================================

n = len(coordinates)

distance_matrix = np.zeros((n, n))

for i in coordinates:
    for j in coordinates:

        xi, yi = coordinates[i]
        xj, yj = coordinates[j]

        distance_matrix[i, j] = math.sqrt(
            (xi - xj) ** 2 +
            (yi - yj) ** 2
        )


# primary vechile minimisation objective
def route_load(route):

    return sum(
        demands[i]
        for i in route
    )


def route_cost(route):

    if not route:
        return 0.0

    cost = distance_matrix[
        DEPOT,
        route[0]
    ]

    for i in range(len(route) - 1):

        cost += distance_matrix[
            route[i],
            route[i + 1]
        ]

    cost += distance_matrix[
        route[-1],
        DEPOT
    ]

    return cost


def distance_cost(solution):

    return sum(
        route_cost(route)
        for route in solution
    )



# upper bound on distance
MAX_DISTANCE = 2.0 * sum(
    distance_matrix[DEPOT, customer]
    for customer in customers
)

# fewer vechiles better
VEHICLE_PENALTY = MAX_DISTANCE + 1.0


def objective(solution):

    vehicles = len(solution)
    distance = distance_cost(solution)

    return (
        vehicles * VEHICLE_PENALTY
        + distance
    )

# check solution is feasible
def feasible(solution):

    seen = []

    for route in solution:

        if not route:
            return False

        if route_load(route) > vehicle_capacity:
            return False

        seen.extend(route)

    return sorted(seen) == sorted(customers)


# create copies of solution
def copy_solution(solution):

    return [
        route.copy()
        for route in solution
    ]


# random intial solution

def random_initial_solution():

    while True:

        shuffled = customers.copy()
        random.shuffle(shuffled)

        solution = []

        success = True

        for customer in shuffled:

            feasible_routes = [
                r
                for r, route in enumerate(solution)
                if (
                    route_load(route)
                    + demands[customer]
                    <= vehicle_capacity
                )
            ]

            # Either insert into an existing vehicle
            # or open a new vehicle.

            if feasible_routes:

                r = random.choice(
                    feasible_routes
                )

                position = random.randint(
                    0,
                    len(solution[r])
                )

                solution[r].insert(
                    position,
                    customer
                )

            else:

                # new route
                if demands[customer] > vehicle_capacity:
                    success = False
                    break

                solution.append(
                    [customer]
                )

        if success and feasible(solution):

            return solution


# use edges as spin representation (1 if used, 0 if not)

def solution_to_edges(solution):

    edges = set()

    for route in solution:

        if not route:
            continue

        previous = DEPOT

        for customer in route:

            edge = tuple(
                sorted(
                    (previous, customer)
                )
            )

            edges.add(edge)

            previous = customer

        # spin matrix symmetric
        edge = tuple(
            sorted(
                (previous, DEPOT)
            )
        )

        edges.add(edge)

    return edges


# spin product (number of shared edges between replica and its neighbours)
# way to quantify similarity between solutions

def spin_products(
    edges_previous,
    edges_current,
    edges_next
):

    return (
        len(
            edges_previous
            & edges_current
        )
        +
        len(
            edges_current
            & edges_next
        )
    )



# find nonempty routes
def nonempty_routes(solution):

    return [
        r
        for r, route in enumerate(solution)
        if route
    ]


# inter-route relocate
# take node out of route and insert in a new route
def insert_move(solution):

    new_solution = copy_solution(solution)

    sources = nonempty_routes(new_solution)

    if not sources:
        return None

    source = random.choice(sources)

    customer = random.choice(
        new_solution[source]
    )

    # Existing routes
    destinations = [
        r
        for r in range(len(new_solution))
        if r != source
    ]

    random.shuffle(destinations)

    for destination in destinations:

        if (
            route_load(new_solution[destination])
            + demands[customer]
            <= vehicle_capacity
        ):

            new_solution[source].remove(
                customer
            )

            position = random.randint(
                0,
                len(new_solution[destination])
            )

            new_solution[destination].insert(
                position,
                customer
            )

            # Remove empty source route.
            if not new_solution[source]:

                del new_solution[source]

            return new_solution

    # allow to create  a new route
    new_solution[source].remove(customer)

    new_solution.append([customer])

    if not new_solution[source]:
        del new_solution[source]

    return new_solution


# inter-route swap move
# take two nodes from two routes and swap them
def swap_move(solution):

    new_solution = copy_solution(solution)

    routes = nonempty_routes(new_solution)

    if len(routes) < 2:
        return None

    r1, r2 = random.sample(routes, 2)

    i = random.randrange(
        len(new_solution[r1])
    )

    j = random.randrange(
        len(new_solution[r2])
    )

    c1 = new_solution[r1][i]
    c2 = new_solution[r2][j]

    load1 = (
        route_load(new_solution[r1])
        - demands[c1]
        + demands[c2]
    )

    load2 = (
        route_load(new_solution[r2])
        - demands[c2]
        + demands[c1]
    )

    if (
        load1 <= vehicle_capacity
        and
        load2 <= vehicle_capacity
    ):

        new_solution[r1][i] = c2
        new_solution[r2][j] = c1

        return new_solution

    return None


# intra-route 2-opt
# select 2 nodes in a route and reverse section between them
def two_opt_move(solution):

    new_solution = copy_solution(solution)

    routes = [
        r
        for r in range(len(new_solution))
        if len(new_solution[r]) >= 4
    ]

    if not routes:
        return None

    r = random.choice(routes)

    route = new_solution[r]

    i, j = sorted(
        random.sample(
            range(len(route)),
            2
        )
    )

    route[i:j + 1] = reversed(
        route[i:j + 1]
    )

    return new_solution


#  swap whole sections between two routes
def cross_move(solution):

    new_solution = copy_solution(solution)

    routes = [
        r
        for r in range(len(new_solution))
        if len(new_solution[r]) >= 2
    ]

    if len(routes) < 2:
        return None

    r1, r2 = random.sample(routes, 2)

    route1 = new_solution[r1]
    route2 = new_solution[r2]

    i1, j1 = sorted(
        random.sample(
            range(len(route1)),
            2
        )
    )

    i2, j2 = sorted(
        random.sample(
            range(len(route2)),
            2
        )
    )

    segment1 = route1[i1:j1 + 1]
    segment2 = route2[i2:j2 + 1]

    load1 = (
        route_load(route1)
        - sum(demands[x] for x in segment1)
        + sum(demands[x] for x in segment2)
    )

    load2 = (
        route_load(route2)
        - sum(demands[x] for x in segment2)
        + sum(demands[x] for x in segment1)
    )

    if (
        load1 <= vehicle_capacity
        and
        load2 <= vehicle_capacity
    ):

        new_solution[r1] = (
            route1[:i1]
            + segment2
            + route1[j1 + 1:]
        )

        new_solution[r2] = (
            route2[:i2]
            + segment1
            + route2[j2 + 1:]
        )

        return new_solution

    return None


# intra-route scramble move
# select segment of one route and scramble it, keeping it in same route
def scramble_move(solution):

    new_solution = copy_solution(solution)

    routes = [
        r
        for r in range(len(new_solution))
        if len(new_solution[r]) >= 3
    ]

    if not routes:
        return None

    r = random.choice(routes)

    route = new_solution[r]

    i, j = sorted(
        random.sample(
            range(len(route)),
            2
        )
    )

    segment = route[i:j + 1]

    random.shuffle(segment)

    route[i:j + 1] = segment

    return new_solution


# inserts continious string of nodes in one route into another
def string_insert_move(solution):

    new_solution = copy_solution(solution)

    sources = [
        r
        for r in range(len(new_solution))
        if len(new_solution[r]) >= 2
    ]

    if not sources:
        return None

    source = random.choice(sources)

    destinations = [
        r
        for r in range(len(new_solution))
        if r != source
    ]

    if not destinations:
        return None

    destination = random.choice(
        destinations
    )

    route = new_solution[source]

    i, j = sorted(
        random.sample(
            range(len(route)),
            2
        )
    )

    segment = route[i:j + 1]

    segment_demand = sum(
        demands[x]
        for x in segment
    )

    if (
        route_load(
            new_solution[destination]
        )
        + segment_demand
        > vehicle_capacity
    ):
        return None

    del route[i:j + 1]

    position = random.randint(
        0,
        len(new_solution[destination])
    )

    new_solution[destination][
        position:position
    ] = segment

    # Remove empty route.
    if not new_solution[source]:

        del new_solution[source]

    return new_solution


# exchange the tails of two routes
def two_opt_star_move(solution):

    new_solution = copy_solution(solution)

    routes = [
        r
        for r in range(len(new_solution))
        if len(new_solution[r]) >= 2
    ]

    if len(routes) < 2:
        return None

    r1, r2 = random.sample(routes, 2)

    route1 = new_solution[r1]
    route2 = new_solution[r2]

    cut1 = random.randint(
        1,
        len(route1) - 1
    )

    cut2 = random.randint(
        1,
        len(route2) - 1
    )

    first1 = route1[:cut1]
    end1 = route1[cut1:]

    first2 = route2[:cut2]
    end2 = route2[cut2:]

    candidate1 = first1 + end2
    candidate2 = first2 + end1

    if (
        route_load(candidate1)
        <= vehicle_capacity
        and
        route_load(candidate2)
        <= vehicle_capacity
    ):

        new_solution[r1] = candidate1
        new_solution[r2] = candidate2

        # Remove empty routes if produced.
        new_solution = [
            route
            for route in new_solution
            if route
        ]

        return new_solution

    return None


# operators
NEIGHBOURS = [
    insert_move,
    swap_move,
    two_opt_move,
    cross_move,
    scramble_move,
    string_insert_move,
    two_opt_star_move
]

# perturb solution and check feasibility of new solution
def make_neighbour(solution):

    for _ in range(10):

        operator = random.choice(
            NEIGHBOURS
        )

        candidate = operator(solution)

        if (
            candidate is not None
            and
            feasible(candidate)
        ):
            return candidate

    return None


# simulated quantum annealing
def qacvrp(
    P=40,
    T=0.0225,
    gamma=3.0,
    gamma_decrement=0.0,
    Mc=20_000
):

    # initialise p replicas (p random solutions)
    # these are spin matrices
    replicas = []

    for _ in range(P):

        solution = random_initial_solution()

        replicas.append({
            "solution": solution,
            "edges": solution_to_edges(solution),
            "objective": objective(solution)
        })

    # initial best solution
    best_replica = min(
        replicas,
        key=lambda x: x["objective"]
    )

    best_solution = copy_solution(
        best_replica["solution"]
    )

    best_objective = best_replica["objective"]

    # monte carlo loop
    for mc in range(Mc):

        x = gamma / (P * T)

        #coupling strength J
        #
        # The P replicas form a ring.
        # J controls how strongly neighbouring
        # replicas are coupled.
        #
        # From the paper:
        #
        # J = -(T/2) ln[tanh(gamma/(P*T))]
        #
        J = -(
            T / 2.0
        ) * math.log(
            math.tanh(x)
        )

        for z in range(P):

            current = replicas[z]

            previous = replicas[
                (z - 1) % P
            ]

            next_replica = replicas[
                (z + 1) % P
            ]

            # perturb solution
            candidate_solution = make_neighbour(
                current["solution"]
            )

            if candidate_solution is None:
                continue

            candidate_edges = solution_to_edges(
                candidate_solution
            )

            candidate_objective = objective(
                candidate_solution
            )

            # change in potential energy
            # change in objective cost of solution
            delta_H_pot = (
                candidate_objective
                - current["objective"]
            )

    
            old_spin_product = spin_products(
                previous["edges"],
                current["edges"],
                next_replica["edges"]
            )

            new_spin_product = spin_products(
                previous["edges"],
                candidate_edges,
                next_replica["edges"]
            )

            # change in kinetic energy
            # Compare the candidate's spin coupling with the
            # current spin coupling:
            #
            # Delta H_kin =
            #       H_kin(candidate)
            #       - H_kin(current)
            #
            # A larger spin product means the candidate shares
            # more edges with its neighbouring replicas.
            delta_H_kin = (
                new_spin_product
                - old_spin_product
            )

            # change in total energy
            # A negative Delta H means that the candidate has a lower
            # effective Hamiltonian and is therefore energetically
            # favourable.
            #
            # a candidate can have a worse CVRP objective
            # (Delta H_pot > 0) but still have a favourable total
            # Delta H if it becomes more strongly coupled to its
            # neighbouring replicas. This is the key feature that gives
            # simulated quantum annealing its quantum-annealing
            # behaviour, rather than simply behaving like ordinary
            # simulated annealing.
            #
            delta_H = (
                delta_H_pot / P
                -
                J * delta_H_kin
            )


            accept = False

            # always accept if cvrp obj improved
            # or if total energy decreased
            if (
                delta_H_pot <= 0
                or
                delta_H <= 0
            ):

                accept = True

            # accept worse solutions with some probability
            else:

                exponent = -delta_H / T

                if exponent > -700:

                    probability = math.exp(
                        exponent
                    )

                    if random.random() < probability:
                        accept = True

            # accept candidate solution
            if accept:

                replicas[z]["solution"] = (
                    candidate_solution
                )

                replicas[z]["edges"] = (
                    candidate_edges
                )

                replicas[z]["objective"] = (
                    candidate_objective
                )

                # if new best
                if (
                    candidate_objective
                    < best_objective
                ):

                    best_objective = (
                        candidate_objective
                    )

                    best_solution = copy_solution(
                        candidate_solution
                    )

        # potentially decrease gamma
        gamma = max(
            0.0,
            gamma - gamma_decrement
        )

        # next step
        if (
            (mc + 1)
            % max(1, Mc // 10)
            == 0
        ):

            print(
                f"MC {mc + 1}/{Mc} | "
                f"Vehicles = {len(best_solution)} | "
                f"Distance = "
                f"{distance_cost(best_solution):.2f} | "
                f"gamma = {gamma:.4f} | "
                f"J = {J:.6f}"
            )

    return (
        best_solution,
        len(best_solution),
        distance_cost(best_solution)
    )


# ============================================================
# MULTIPLE RUNS
# ============================================================

if __name__ == "__main__":

    print("=" * 70)
    print(
        "QACVRP - Primary Vehicle Minimisation"
    )
    print("=" * 70)

    print(
        f"P={P}, "
        f"T={T}, "
        f"gamma={GAMMA}, "
        f"gamma decrement={GAMMA_DECREMENT}, "
        f"Mc={MC_STEPS}"
    )

    print(
        f"Effective quantum temperature PT = "
        f"{P * T:.4f}"
    )

    print(
        f"Vehicle penalty = "
        f"{VEHICLE_PENALTY:.2f}"
    )

    print()

    results = []
    runtimes = []

    for run in range(NUM_RUNS):

        start = time.time()

        (
            best_solution,
            vehicles,
            distance
        ) = qacvrp(
            P=P,
            T=T,
            gamma=GAMMA,
            gamma_decrement=GAMMA_DECREMENT,
            Mc=MC_STEPS
        )

        elapsed = time.time() - start

        results.append(
            (vehicles, distance)
        )

        runtimes.append(elapsed)

        print(
            f"Run {run + 1}: "
            f"vehicles={vehicles}, "
            f"distance={distance:.2f}, "
            f"time={elapsed:.3f}s"
        )

    # ========================================================
    # SUMMARY
    # ========================================================

    vehicle_counts = [
        x[0]
        for x in results
    ]

    distances = [
        x[1]
        for x in results
    ]

    mean_vehicles = np.mean(
        vehicle_counts
    )

    best_vehicles = min(
        vehicle_counts
    )

    mean_distance = np.mean(
        distances
    )

    best_distance = min(
        distances
    )

    std_distance = np.std(
        distances
    )

    mean_runtime = np.mean(
        runtimes
    )

    distance_gap = (
        (mean_distance - OPTIMAL_DISTANCE)
        / OPTIMAL_DISTANCE
        * 100
    )

    print()
    print("=" * 70)

    print(
        f"Mean vehicles:   "
        f"{mean_vehicles:.2f}"
    )

    print(
        f"Best vehicles:   "
        f"{best_vehicles}"
    )

    print(
        f"Mean distance:   "
        f"{mean_distance:.2f}"
    )

    print(
        f"Best distance:   "
        f"{best_distance:.2f}"
    )

    print(
        f"Std distance:    "
        f"{std_distance:.2f}"
    )

    print(
        f"Mean runtime:    "
        f"{mean_runtime:.3f} seconds"
    )

    print(
        f"Distance gap:    "
        f"{distance_gap:.2f}%"
    )

    print("=" * 70)

