df = pd.DataFrame(data)

# ============================================================
# PERFORMANCE RATIOS
# ============================================================

algorithms = ["SA", "ALNS", "GA", "QA"]

# Best runtime for each problem
best_runtime = df[algorithms].min(axis=1)

# Performance ratio:
# runtime of algorithm / best runtime for that problem
ratios = df[algorithms].div(best_runtime, axis=0)

# ============================================================
# PERFORMANCE PROFILE
# ============================================================

n_problems = len(df)

plt.figure(figsize=(8, 6))

for algorithm in algorithms:

    # Sort performance ratios
    r = np.sort(ratios[algorithm].values)

    # Cumulative proportion of problems
    rho = np.arange(1, n_problems + 1) / n_problems

    # Add starting point
    x = np.insert(r, 0, 1)
    y = np.insert(rho, 0, 0)

    # Step function
    plt.step(
        x,
        y,
        where="post",
        label=algorithm
    )

# ============================================================
# PLOT SETTINGS
# ============================================================


plt.xlabel(r"$\tau$ (factor of best runtime)")
plt.ylabel(r"$\rho_s(\tau)$")

plt.ylim(0, 1.02)

plt.grid(
    True,
    which="both",
    alpha=0.25
)

plt.legend()

plt.tight_layout()

