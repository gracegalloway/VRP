df = pd.DataFrame(data)

algorithms = ["SA", "ALNS", "GA", "QA"]

# ============================================================
# PERFORMANCE PROFILE FUNCTION
# ============================================================

def performance_profile(gaps):
    """
    Calculate cumulative performance profile.

    gaps = percentage gaps to optimal for one algorithm
    """

    gaps = np.sort(np.asarray(gaps))

    n = len(gaps)

    x = np.concatenate(([0], gaps))
    y = np.concatenate(([0], np.arange(1, n + 1) / n))

    return x, y


# ============================================================
# NORMAL GAP PERFORMANCE PROFILE
# ============================================================

plt.figure(figsize=(9, 6))

for alg in algorithms:

    x, y = performance_profile(df[alg])

    plt.step(
        x,
        y,
        where="post",
        label=alg
    )

plt.xlabel(r"$\tau$ Gap to optimal (%)")
plt.ylabel(r"$\rho_s(\tau)$")
plt.title("Performance Profile Based on Gap to Optimal")

plt.xlim(left=0)
plt.ylim(0, 1.02)

plt.grid(True, alpha=0.3)
plt.legend()

plt.tight_layout()

plt.savefig(
    "gap_performance_profile.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


# ============================================================
# LOG-SCALE GAP PERFORMANCE PROFILE
# ============================================================

plt.figure(figsize=(9, 6))

for alg in algorithms:

    gaps = np.sort(df[alg].values)

    # Log scale cannot display zero.
    # Replace zero with a very small positive value.
    gaps_plot = np.where(gaps == 0, 0.01, gaps)

    n = len(gaps_plot)

    x = np.concatenate(([0.01], gaps_plot))
    y = np.concatenate(([0], np.arange(1, n + 1) / n))

    plt.step(
        x,
        y,
        where="post",
        label=alg
    )

plt.xscale("log")

plt.xlabel(r"$\tau$ Gap to optimal (%)")
plt.ylabel(r"$\rho_s(\tau)$")
plt.title("Performance Profile Based on Gap to Optimal (Log Scale)")

plt.ylim(0, 1.02)

plt.grid(True, alpha=0.3)
plt.legend()

plt.tight_layout()

