df = pd.DataFrame(
    data,
    columns=["Instance", "Algorithm", "MeanCost", "OptimalCost", "Runtime"]
)

# ============================================================
# QUALITY PERFORMANCE RATIO
# ============================================================

# Best solution found by ANY algorithm for each instance
best_cost = df.groupby("Instance")["MeanCost"].transform("min")

# Ratio relative to the best algorithm on that instance
df["QualityRatio"] = df["MeanCost"] / best_cost

# ============================================================
# PERFORMANCE PROFILE
# ============================================================

algorithms = ["SA", "ALNS", "GA", "QA"]

tau = np.logspace(0, np.log10(df["QualityRatio"].max()), 1000)

plt.figure(figsize=(8, 6))

for alg in algorithms:

    ratios = df.loc[df["Algorithm"] == alg, "QualityRatio"].values

    rho = np.array([
        np.mean(ratios <= t)
        for t in tau
    ])

    plt.step(
        tau,
        rho,
        where="post",
        label=alg
    )

plt.xlabel(r"$\tau$")
plt.ylabel(r"$\rho_s(\tau)$")
plt.title("Solution Quality Performance Profile")
plt.ylim(0, 1.02)
plt.xlim(1, None)
plt.grid(True, alpha=0.3)
plt.legend()

plt.tight_layout()
plt.savefig(
    "gap_performance_profile.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()

# ============================================================
# LOG-TAU PERFORMANCE PROFILE
# ============================================================

plt.figure(figsize=(8, 6))

for alg in algorithms:

    ratios = df.loc[df["Algorithm"] == alg, "QualityRatio"].values

    rho = np.array([
        np.mean(ratios <= t)
        for t in tau
    ])

    plt.step(
        np.log2(tau),
        rho,
        where="post",
        label=alg
    )

plt.xlabel(r"$\log_2(\tau)$")
plt.ylabel(r"$\rho_s(\tau)$")
plt.title("Solution Quality Performance Profile")
plt.ylim(0, 1.02)
plt.grid(True, alpha=0.3)
plt.legend()

plt.tight_layout()
plt.savefig(
    "gap_performance_profile_log.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()

# ============================================================
# PRINT PERFORMANCE AT IMPORTANT TAU VALUES
# ============================================================

print("\nSolution quality performance profile:")
print("--------------------------------------")

for tau_value in [1, 1.01, 1.02, 1.05, 1.10, 1.25, 1.5, 2, 5]:

    print(f"\ntau = {tau_value}")

    for alg in algorithms:

        ratios = df.loc[
            df["Algorithm"] == alg,
            "QualityRatio"
        ].values

        rho = np.mean(ratios <= tau_value)

        print(
            f"{alg:5s}: "
