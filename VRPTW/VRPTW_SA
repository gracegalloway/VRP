import numpy as np
import random
import time
import math
import copy


random.seed(20)


OPTIMAL_COST = 827.3


instance = "Instances/C101.txt"


coordinates = {}
demands = {}
ready_time = {}
due_time = {}
service_time = {}


with open(instance, "r") as f:
    lines = f.readlines()


# vehicle capacity
for i,line in enumerate(lines):
    if "CAPACITY" in line:
        vehicle_capacity = int(lines[i+1].split()[1])
        break


# customer data
start = None

for i,line in enumerate(lines):
    if line.strip().startswith("0"):
        start = i
        break


for line in lines[start:]:

    data = line.split()

    if len(data) < 7:
        continue

    customer = int(data[0])

    coordinates[customer] = (
        int(data[1]),
        int(data[2])
    )

    demands[customer] = int(data[3])

    ready_time[customer] = int(data[4])

    due_time[customer] = int(data[5])

    service_time[customer] = int(data[6])


n = len(coordinates)



# distance

def euclidean(a,b):

    return round(math.hypot(
            a[0]-b[0],
            a[1]-b[1]
        ),1)


distance = [
    [
        euclidean(coordinates[i],coordinates[j])
        for j in range(n)
    ]
    for i in range(n)
]



# vrptw function

def route_load(route):

    return sum(demands[i] for i in route)


# hard time windows
def feasible_route(route):

    if route_load(route) > vehicle_capacity:
        return False

    current_time = 0
    previous = 0

    for customer in route:

        current_time += distance[previous][customer]

        if current_time > due_time[customer]:
            return False

        current_time = max(
            current_time,
            ready_time[customer]
        )

        current_time += service_time[customer]

        previous = customer


    # return to depot
    current_time += distance[previous][0]

    if current_time > due_time[0]:
        return False


    return True



def route_cost(route):

    if len(route)==0:
        return 0

    cost = 0
    current_time = 0
    previous = 0

    for customer in route:

        travel = distance[previous][customer]

        cost += travel

        current_time += travel

        if current_time < ready_time[customer]:

            current_time = ready_time[customer]

        current_time += service_time[customer]

        previous = customer

    cost += distance[previous][0]
    return cost


def total_cost(solution):

    return sum(route_cost(r) for r in solution)

# vehicle minimisation objective
VEHICLE_PENALTY = 10000

def objective(solution):

    return (
        VEHICLE_PENALTY * len(solution)
        + total_cost(solution)
    )


# cw init_sol
def CW_initial_solution():

    # initial routes
    routes = {i: [i] for i in range(1, n)}

    loads = {
        i: demands[i]
        for i in range(1, n)
    }

    customer_route = {
        i: i
        for i in range(1, n)
    }


    # compute savings
    savings = []

    for i in range(1,n):

        for j in range(i+1,n):

            s = (
                distance[0][i]
                + distance[0][j]
                - distance[i][j]
            )

            savings.append((s,i,j))


    savings.sort(reverse=True)



    # merge routes

    for saving,i,j in savings:


        ri = customer_route[i]
        rj = customer_route[j]


        # already same route
        if ri == rj:
            continue


        route_i = routes[ri]
        route_j = routes[rj]


        # capacity check
        if loads[ri] + loads[rj] > vehicle_capacity:
            continue

        merged = None

        # i end, j start
        if route_i[-1] == i and route_j[0] == j:

            merged = route_i + route_j


        # j end, i start
        elif route_j[-1] == j and route_i[0] == i:

            merged = route_j + route_i


        # both start
        elif route_i[0] == i and route_j[0] == j:

            merged = list(reversed(route_i)) + route_j


        # both end
        elif route_i[-1] == i and route_j[-1] == j:

            merged = route_i + list(reversed(route_j))

        if merged is None:
            continue

        # VRPTW feasibility check
        if not feasible_route(merged):
            continue


        # merge

        routes[ri] = merged

        loads[ri] += loads[rj]


        for customer in merged:
            customer_route[customer] = ri


        del routes[rj]
        del loads[rj]



    return list(routes.values())




# neighbourhoods

def inter_relocate(solution):

    sol = copy.deepcopy(solution)

    r1 = random.randrange(len(sol))

    if len(sol[r1]) == 0:
        return sol

    customer = random.choice(sol[r1])

    sol[r1].remove(customer)

    removed_route = False

    if len(sol[r1]) == 0:
        sol.pop(r1)
        removed_route = True


    for r2 in range(len(sol)):

        # skip original route if it still exists
        if not removed_route and r2 == r1:
            continue

        for pos in range(len(sol[r2])+1):

            new = sol[r2].copy()
            new.insert(pos, customer)

            if feasible_route(new):
                sol[r2] = new
                return sol


    sol.append([customer])

    return sol




def inter_swap(solution):

    sol=copy.deepcopy(solution)


    if len(sol)<2:
        return sol


    r1,r2=random.sample(range(len(sol)),2)


    if not sol[r1] or not sol[r2]:
        return sol


    i=random.randrange(len(sol[r1]))
    j=random.randrange(len(sol[r2]))


    a=sol[r1][i]
    b=sol[r2][j]


    new1=sol[r1].copy()
    new2=sol[r2].copy()


    new1[i]=b
    new2[j]=a


    if feasible_route(new1) and feasible_route(new2):

        sol[r1]=new1
        sol[r2]=new2


    return sol





def inter_2_opt(solution):

    sol=copy.deepcopy(solution)


    if len(sol)<2:
        return sol


    r1,r2=random.sample(range(len(sol)),2)


    i=random.randrange(len(sol[r1]))
    j=random.randrange(len(sol[r2]))


    new1=sol[r1][:i]+sol[r2][j:]
    new2=sol[r2][:j]+sol[r1][i:]


    if feasible_route(new1) and feasible_route(new2):

        sol[r1]=new1
        sol[r2]=new2


    return sol


def intra_relocate(solution):

    sol=copy.deepcopy(solution)

    r=random.randrange(len(sol))


    if len(sol[r])<2:
        return sol


    customer=sol[r].pop(
        random.randrange(len(sol[r]))
    )


    pos=random.randrange(len(sol[r])+1)

    sol[r].insert(pos,customer)


    if not feasible_route(sol[r]):

        return solution


    return sol



def intra_swap(solution):

    sol=copy.deepcopy(solution)


    r=random.randrange(len(sol))


    if len(sol[r])<2:
        return sol


    i,j=random.sample(
        range(len(sol[r])),2
    )


    sol[r][i],sol[r][j]=sol[r][j],sol[r][i]


    if not feasible_route(sol[r]):

        return solution


    return sol


def intra_2_opt(solution):

    sol=copy.deepcopy(solution)


    r=random.randrange(len(sol))


    if len(sol[r])<4:
        return sol


    i,j=sorted(
        random.sample(range(len(sol[r])),2)
    )


    sol[r][i:j]=reversed(sol[r][i:j])


    if not feasible_route(sol[r]):

        return solution


    return sol



ops=[
    inter_relocate,
    inter_swap,
    inter_2_opt,
    intra_relocate,
    intra_swap,
    intra_2_opt
]

# standard SA
def simulated_annealing(
        weights,
        initial_solution_func,
        initial_temp=1000,
        cooling_rate=0.995,
        stopping_temp=1e-3,
        iterations_per_temp=100):


    current=initial_solution_func()

    current_cost=objective(current)


    best=copy.deepcopy(current)

    best_cost=current_cost


    T=initial_temp



    while T>stopping_temp:


        for _ in range(iterations_per_temp):


            op=choose(weights)


            candidate=ops[op](current)


            candidate_cost=objective(candidate)


            delta=candidate_cost-current_cost


            accepted=False


            if delta<0:

                current=candidate
                current_cost=candidate_cost
                accepted=True


            elif random.random()<math.exp(-delta/T):

                current=candidate
                current_cost=candidate_cost
                accepted=True



            new_best=False


            if current_cost<best_cost:

                best=copy.deepcopy(current)

                best_cost=current_cost

                new_best=True


        T*=cooling_rate



    return best,best_cost

# reward SA


def choose(weights):

    total=sum(weights)

    r=random.random()*total

    cumulative=0


    for i,w in enumerate(weights):

        cumulative+=w

        if cumulative>=r:

            return i


    return len(weights)-1


def rewards_simulated_annealing(
        weights,
        initial_solution_func,
        initial_temp=1000,
        cooling_rate=0.995,
        stopping_temp=1e-3,
        iterations_per_temp=100):


    current=initial_solution_func()

    current_cost=objective(current)


    best=copy.deepcopy(current)

    best_cost=current_cost


    T=initial_temp



    while T>stopping_temp:


        for _ in range(iterations_per_temp):


            op=choose(weights)


            candidate=ops[op](current)


            candidate_cost=objective(candidate)


            delta=candidate_cost-current_cost


            accepted=False


            if delta<0:

                current=candidate
                current_cost=candidate_cost
                accepted=True


            elif random.random()<math.exp(-delta/T):

                current=candidate
                current_cost=candidate_cost
                accepted=True



            new_best=False


            if current_cost<best_cost:

                best=copy.deepcopy(current)

                best_cost=current_cost

                new_best=True



            if new_best:

                weights[op]+=20

            elif accepted and delta<0:

                weights[op]+=5

            elif accepted:

                weights[op]+=1



            weights[op]*=0.9995



        T*=cooling_rate



    return best,best_cost


# run
results = {}


costs = []
runtimes = []

costs = []
vehicle_counts = []
runtimes = []

for run in range(10):

    weights = [5,5,5, 1, 1, 1]

    start = time.time()

    best_solution, best_objective = simulated_annealing(
        weights,
        CW_initial_solution
    )

    end = time.time()

    distance_cost = total_cost(best_solution)
    vehicles = len(best_solution)

    print(
        f"Run {run+1}: "
        f"vehicles={vehicles}, "
        f"distance={distance_cost:.2f}, "
        f"objective={best_objective:.2f}"
    )

    costs.append(distance_cost)
    vehicle_counts.append(vehicles)
    runtimes.append(end - start)

results[f"x"] = {
    "mean_cost": np.mean(costs),
    "best_cost": min(costs),
    "std_cost": np.std(costs),
    "mean_runtime": np.mean(runtimes),
    "gap": ((np.mean(costs) - OPTIMAL_COST) / OPTIMAL_COST) * 100
    }


for name, result in results.items():

    print("\nSwitch temperature:", name)
    print("Mean cost:", round(result["mean_cost"], 2))
    print("Best cost:", round(result["best_cost"], 2))
    print("Std deviation:", round(result["std_cost"], 2))
    print("Mean runtime:", round(result["mean_runtime"], 3), "seconds")
    print("Gap from optimum:", round(result["gap"], 2), "%")
    