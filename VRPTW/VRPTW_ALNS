# EXPERIMENT
#############################################################################

fractions = [0.1,0.2,
    0.3,0.4
]

runs = 10


print(
    f"{'Fraction':<12}"
    f"{'Mean Cost':<12}"
    f"{'Best Cost':<12}"
    f"{'Std Dev':<12}"
    f"{'Runtime':<12}"
    f"{'Gap (%)':<10}"
)


for fraction in fractions:

    costs = []
    runtimes = []

    for seed in range(runs):

        random.seed(seed)

        #####################################################################
        # RESET ALL WEIGHTS
        #####################################################################

        destroy_weights[:] = [
            1.0,
            1.0
        ]

        repair_weights[:] = [
            1.0,
            1.0
        ]

        #####################################################################
        # Run
        #####################################################################

        start = time.time()

        best_solution, best_objective = alns(
            remove_fraction=fraction
        )

        runtime = (
            time.time()
            - start
        )

        #####################################################################
        # Actual distance
        #####################################################################

        cost = total_cost(
            best_solution
        )

        costs.append(cost)

        runtimes.append(runtime)

    #########################################################################
    # Statistics
    #########################################################################

    mean_cost = (
        sum(costs)
        / len(costs)
    )

    best_cost = min(costs)

    variance = (
        sum(
            (x - mean_cost) ** 2
            for x in costs
        )
        / len(costs)
    )

    std = math.sqrt(
        variance
    )

    mean_runtime = (
        sum(runtimes)
        / len(runtimes)
    )

    gap = (
        (mean_cost - OPTIMAL_COST)
        / OPTIMAL_COST
    ) * 100

    print(
        f"{fraction:<12.2f}"
        f"{mean_cost:<12.2f}"
        f"{best_cost:<12.2f}"
        f"{std:<12.2f}"
        f"{mean_runtime:<12.3f}"
        f"{gap:<10.2f}"
    )