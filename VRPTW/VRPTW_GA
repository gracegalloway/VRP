import numpy as np
import random
import time
import matplotlib.pyplot as plt
import math
import copy

random.seed(20)

OPTIMAL_COST = 827.3

INSTANCE = "Instances/RC204.txt"


# ============================================================
# SOLOMON INSTANCE
# ============================================================

with open(INSTANCE, "r") as f:

    lines = [
        line.strip()
        for line in f
        if line.strip()
    ]


# ============================================================
# VEHICLE CAPACITY
# ============================================================

capacity_index = None

for i, line in enumerate(lines):

    if "CAPACITY" in line.upper():

        capacity_index = i
        break


if capacity_index is None:

    raise ValueError(
        "Could not find CAPACITY in instance file."
    )


vehicle_capacity = int(
    lines[capacity_index + 1].split()[1]
)


# ============================================================
# CUSTOMER DATA
# ============================================================

data_start = None

for i, line in enumerate(lines):

    if line.upper().startswith("CUST NO."):

        data_start = i + 1
        break


if data_start is None:

    raise ValueError(
        "Could not find customer data header."
    )


coordinates = {}
demands = {}
ready_time = {}
due_time = {}
service_time = {}


for line in lines[data_start:]:

    parts = line.split()

    if len(parts) < 7:
        continue

    try:

        customer = int(parts[0])

        x = float(parts[1])
        y = float(parts[2])

        demand = int(parts[3])

        ready = float(parts[4])
        due = float(parts[5])

        service = float(parts[6])

    except ValueError:

        continue

    coordinates[customer] = (x, y)

    demands[customer] = demand

    ready_time[customer] = ready
    due_time[customer] = due
    service_time[customer] = service


# ============================================================
# DEPOT / CUSTOMERS
# ============================================================

DEPOT = 0

customers = [
    i
    for i in coordinates
    if i != DEPOT
]

n = len(coordinates)


# ============================================================
# DISTANCE MATRIX
# ============================================================

def euclidean(a, b):

    return round(
        math.hypot(
            a[0] - b[0],
            a[1] - b[1]
        ),
        1
    )


distance = [
    [
        euclidean(
            coordinates[i],
            coordinates[j]
        )
        for j in range(n)
    ]
    for i in range(n)
]


# ============================================================
# ROUTE LOAD
# ============================================================

def route_load(route):

    return sum(
        demands[i]
        for i in route
    )


# ============================================================
# ROUTE TIME-WINDOW FEASIBILITY
# ============================================================

def route_feasible(route):

    if not route:

        return False

    if (
        route_load(route)
        >
        vehicle_capacity
    ):

        return False

    current_time = ready_time[DEPOT]

    previous = DEPOT

    for customer in route:

        arrival_time = (
            current_time
            +
            distance[
                previous
            ][
                customer
            ]
        )

        service_start = max(
            arrival_time,
            ready_time[customer]
        )

        if (
            service_start
            >
            due_time[customer]
        ):

            return False

        current_time = (
            service_start
            +
            service_time[customer]
        )

        previous = customer


    return_time = (
        current_time
        +
        distance[
            previous
        ][
            DEPOT
        ]
    )

    if (
        return_time
        >
        due_time[DEPOT]
    ):

        return False

    return True


# ============================================================
# SOLUTION FEASIBILITY
# ============================================================

def feasible(solution):

    seen = []

    for route in solution:

        if not route:

            return False

        if not route_feasible(route):

            return False

        seen.extend(route)

    return (
        sorted(seen)
        ==
        sorted(customers)
    )


# ============================================================
# ROUTE COST
# ============================================================

def route_cost(route):

    if len(route) == 0:

        return 0

    cost = distance[
        DEPOT
    ][
        route[0]
    ]

    for i in range(
        len(route) - 1
    ):

        cost += distance[
            route[i]
        ][
            route[i + 1]
        ]

    cost += distance[
        route[-1]
    ][
        DEPOT
    ]

    return cost


# ============================================================
# TOTAL COST
# ============================================================

def total_cost(solution):

    return sum(
        route_cost(route)
        for route in solution
    )


# ============================================================
# MINIMUM NUMBER OF VEHICLES
# ============================================================

min_K = math.ceil(
    sum(
        demands[i]
        for i in customers
    )
    /
    vehicle_capacity
)


# ============================================================
# VEHICLE PENALTY
# ============================================================

vehicle_penalty = 1000


# ============================================================
# OBJECTIVE
# ============================================================

def objective(solution):

    if not feasible(solution):

        return float("inf")

    extra = max(
        0,
        len(solution) - min_K
    )

    return (
        total_cost(solution)
        +
        vehicle_penalty * extra
    )


# ============================================================
# CLARKE-WRIGHT INITIAL SOLUTION
# ============================================================

def CW_initial_solution():

    routes = {
        i: [i]
        for i in customers
    }

    loads = {
        i: demands[i]
        for i in customers
    }

    customer_route = {
        i: i
        for i in customers
    }


    # ========================================================
    # SAVINGS
    # ========================================================

    savings = []

    for i in customers:

        for j in customers:

            if i >= j:

                continue

            s = (
                distance[
                    DEPOT
                ][
                    i
                ]
                +
                distance[
                    DEPOT
                ][
                    j
                ]
                -
                distance[i][j]
            )

            savings.append(
                (
                    s,
                    i,
                    j
                )
            )


    savings.sort(
        reverse=True
    )


    # ========================================================
    # MERGE ROUTES
    # ========================================================

    for saving, i, j in savings:

        if saving <= 0:

            break


        ri = customer_route[i]
        rj = customer_route[j]


        if ri == rj:

            continue


        route_i = routes[ri]
        route_j = routes[rj]


        if (
            loads[ri]
            +
            loads[rj]
            >
            vehicle_capacity
        ):

            continue


        merged = None


        # i at end of route_i,
        # j at start of route_j

        if (
            route_i[-1] == i
            and
            route_j[0] == j
        ):

            merged = (
                route_i
                +
                route_j
            )


        # j at end of route_j,
        # i at start of route_i

        elif (
            route_j[-1] == j
            and
            route_i[0] == i
        ):

            merged = (
                route_j
                +
                route_i
            )


        # both start points

        elif (
            route_i[0] == i
            and
            route_j[0] == j
        ):

            merged = (
                list(
                    reversed(route_i)
                )
                +
                route_j
            )


        # both end points

        elif (
            route_i[-1] == i
            and
            route_j[-1] == j
        ):

            merged = (
                route_i
                +
                list(
                    reversed(route_j)
                )
            )


        if merged is None:

            continue


        # ====================================================
        # TW FEASIBILITY CHECK
        # ====================================================

        if not route_feasible(
            merged
        ):

            continue


        # ====================================================
        # PERFORM MERGE
        # ====================================================

        routes[ri] = merged

        loads[ri] += loads[rj]

        for customer in merged:

            customer_route[
                customer
            ] = ri

        del routes[rj]

        del loads[rj]


    solution = list(
        routes.values()
    )


    if feasible(solution):

        return solution


    return random_initial_solution()


# ============================================================
# RANDOM INITIAL SOLUTION
# ============================================================

def random_initial_solution():

    while True:

        shuffled = customers.copy()

        random.shuffle(
            shuffled
        )

        solution = []

        success = True


        for customer in shuffled:

            feasible_insertions = []


            # =================================================
            # TRY EXISTING ROUTES
            # =================================================

            for r in range(
                len(solution)
            ):

                route = solution[r]


                if (
                    route_load(route)
                    +
                    demands[customer]
                    >
                    vehicle_capacity
                ):

                    continue


                for position in range(
                    len(route) + 1
                ):

                    candidate_route = (
                        route[:position]
                        +
                        [customer]
                        +
                        route[position:]
                    )


                    if route_feasible(
                        candidate_route
                    ):

                        feasible_insertions.append(
                            (
                                r,
                                position
                            )
                        )


            # =================================================
            # INSERT INTO EXISTING ROUTE
            # =================================================

            if feasible_insertions:

                r, position = random.choice(
                    feasible_insertions
                )

                solution[r].insert(
                    position,
                    customer
                )


            # =================================================
            # CREATE NEW ROUTE
            # =================================================

            else:

                new_route = [
                    customer
                ]

                if route_feasible(
                    new_route
                ):

                    solution.append(
                        new_route
                    )

                else:

                    success = False

                    break


        if (
            success
            and
            feasible(solution)
        ):

            return solution


# ============================================================
# CROSSOVER
# ============================================================

def crossover(
    parent1,
    parent2
):

    p1 = copy.deepcopy(
        parent1
    )

    p2 = copy.deepcopy(
        parent2
    )

    child = []


    # ========================================================
    # SELECT ROUTES FROM PARENT 1
    # ========================================================

    random.shuffle(p1)


    number_routes = random.randint(
        1,
        max(
            1,
            len(p1) - 1
        )
    )


    selected_routes = p1[
        :number_routes
    ]


    # Only inherit routes that are
    # individually feasible

    for route in selected_routes:

        if route_feasible(
            route
        ):

            child.append(
                copy.deepcopy(route)
            )


    # ========================================================
    # INHERITED CUSTOMERS
    # ========================================================

    inherited_customers = set()

    for route in child:

        inherited_customers.update(
            route
        )


    # ========================================================
    # REMAINING CUSTOMERS FROM PARENT 2
    # ========================================================

    remaining_customers = []

    for route in p2:

        for customer in route:

            if (
                customer
                not in
                inherited_customers
            ):

                remaining_customers.append(
                    customer
                )


    # ========================================================
    # INSERT REMAINING CUSTOMERS
    # ========================================================

    random.shuffle(
        remaining_customers
    )


    for customer in remaining_customers:

        best_route = None

        best_position = None

        best_delta = float(
            "inf"
        )


        # ====================================================
        # TRY EXISTING ROUTES
        # ====================================================

        for r_idx, route in enumerate(
            child
        ):

            if (
                route_load(route)
                +
                demands[customer]
                >
                vehicle_capacity
            ):

                continue


            old_cost = route_cost(
                route
            )


            for pos in range(
                len(route) + 1
            ):

                new_route = (
                    route[:pos]
                    +
                    [customer]
                    +
                    route[pos:]
                )


                if not route_feasible(
                    new_route
                ):

                    continue


                new_cost = route_cost(
                    new_route
                )


                delta = (
                    new_cost
                    -
                    old_cost
                )


                if delta < best_delta:

                    best_delta = delta

                    best_route = r_idx

                    best_position = pos


        # ====================================================
        # BEST EXISTING ROUTE
        # ====================================================

        if best_route is not None:

            child[
                best_route
            ].insert(
                best_position,
                customer
            )


        # ====================================================
        # NEW ROUTE
        # ====================================================

        else:

            new_route = [
                customer
            ]


            if route_feasible(
                new_route
            ):

                child.append(
                    new_route
                )

            else:

                return random_initial_solution()


    # ========================================================
    # FINAL FEASIBILITY CHECK
    # ========================================================

    if feasible(child):

        return child


    return random_initial_solution()


# ============================================================
# MUTATION
# ============================================================

def mutate(solution):

    sol = copy.deepcopy(
        solution
    )


    move = random.choice(
        [
            "swap",
            "relocate",
            "reverse"
        ]
    )


    # ========================================================
    # SWAP
    # ========================================================

    if move == "swap":

        if len(sol) < 2:

            return sol


        r1, r2 = random.sample(
            range(len(sol)),
            2
        )


        if (
            not sol[r1]
            or
            not sol[r2]
        ):

            return sol


        i = random.randrange(
            len(sol[r1])
        )

        j = random.randrange(
            len(sol[r2])
        )


        a = sol[r1][i]

        b = sol[r2][j]


        candidate = copy.deepcopy(
            sol
        )


        candidate[r1][i] = b

        candidate[r2][j] = a


        if feasible(
            candidate
        ):

            return candidate


    # ========================================================
    # RELOCATE
    # ========================================================

    elif move == "relocate":

        if not sol:

            return sol


        r1 = random.randrange(
            len(sol)
        )


        if not sol[r1]:

            return sol


        idx = random.randrange(
            len(sol[r1])
        )


        customer = sol[r1].pop(
            idx
        )


        if not sol[r1]:

            sol.pop(r1)


        # Try existing routes

        destinations = list(
            range(len(sol))
        )


        random.shuffle(
            destinations
        )


        for r2 in destinations:

            for pos in range(
                len(sol[r2]) + 1
            ):

                candidate = copy.deepcopy(
                    sol
                )


                candidate[r2].insert(
                    pos,
                    customer
                )


                if feasible(
                    candidate
                ):

                    return candidate


        # Try new route

        new_route = [
            customer
        ]


        if route_feasible(
            new_route
        ):

            sol.append(
                new_route
            )


            if feasible(sol):

                return sol


    # ========================================================
    # REVERSE
    # ========================================================

    else:

        routes = [
            r
            for r in sol
            if len(r) >= 4
        ]


        if routes:

            route = random.choice(
                routes
            )


            idx = sol.index(
                route
            )


            i, j = sorted(
                random.sample(
                    range(len(route)),
                    2
                )
            )


            candidate = copy.deepcopy(
                sol
            )


            candidate[idx][
                i:j + 1
            ] = reversed(
                candidate[idx][
                    i:j + 1
                ]
            )


            if feasible(
                candidate
            ):

                return candidate


    return sol


# ============================================================
# TOURNAMENT SELECTION
# ============================================================

def tournament(
    population,
    k=3
):

    competitors = random.sample(
        population,
        k
    )

    competitors.sort(
        key=lambda x: x[1]
    )

    return competitors[0][0]


# ============================================================
# RBC GENETIC ALGORITHM
# ============================================================

def RBC_genetic_algorithm(
        pop_size=50,
        generations=300,
        elite_size=5,
        mutation_rate=0.9,
        crossover_rate=0.9):


    population = []


    # ========================================================
    # INITIAL POPULATION
    # ========================================================

    num_cw = int(
        0.2 * pop_size
    )


    for i in range(
        pop_size
    ):

        if i < num_cw:

            s = CW_initial_solution()


            for _ in range(
                random.randint(1, 3)
            ):

                s = mutate(s)


        else:

            s = random_initial_solution()


        if not feasible(s):

            s = random_initial_solution()


        population.append(
            (
                s,
                total_cost(s)
            )
        )


    best_solution = None

    best_cost = float(
        "inf"
    )


    # ========================================================
    # GENERATIONS
    # ========================================================

    for generation in range(
        generations
    ):


        population.sort(
            key=lambda x: x[1]
        )


        if (
            population[0][1]
            <
            best_cost
        ):

            best_solution = (
                copy.deepcopy(
                    population[0][0]
                )
            )

            best_cost = (
                population[0][1]
            )


        new_population = []


        # ====================================================
        # ELITISM
        # ====================================================

        for i in range(
            elite_size
        ):

            new_population.append(
                copy.deepcopy(
                    population[i]
                )
            )


        # ====================================================
        # CROSSOVER + MUTATION
        # ====================================================

        while len(
            new_population
        ) < pop_size:


            parent1 = tournament(
                population
            )

            parent2 = tournament(
                population
            )


            attempts = 0


            while (
                parent1 == parent2
                and
                attempts < 5
            ):

                parent2 = tournament(
                    population
                )

                attempts += 1


            # =================================================
            # CROSSOVER
            # =================================================

            if (
                random.random()
                <
                crossover_rate
            ):

                child = crossover(
                    parent1,
                    parent2
                )

            else:

                child = copy.deepcopy(
                    parent1
                )


            # =================================================
            # MUTATION
            # =================================================

            if (
                random.random()
                <
                mutation_rate
            ):

                child = mutate(
                    child
                )


            # =================================================
            # ENSURE FEASIBILITY
            # =================================================

            if not feasible(
                child
            ):

                child = (
                    random_initial_solution()
                )


            # =================================================
            # ADD CHILD
            # =================================================

            new_population.append(
                (
                    child,
                    total_cost(child)
                )
            )


        population = (
            new_population
        )


        print(
            f"Generation "
            f"{generation:3d} "
            f"Best = "
            f"{best_cost:.2f} "
            f"Vehicles = "
            f"{len(best_solution)}"
        )


    return (
        best_solution,
        best_cost
    )


# ============================================================
# RUN
# ============================================================

best, cost = (
